<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <CetCompat>false</CetCompat>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!--
            可执行文件图标（资源管理器 / 任务栏兜底）：与窗口、托盘共用 Corkboard 资产里的多尺寸 ICO。
            ICO 由同目录的母版 Corkboard.png 生成（16/20/24/32/40/48/64/128 BMP 32bpp + 256 PNG），
            换图标时母版和 ICO 要一起换，不要只改一边。
            运行期的窗口图标不用这份 ICO，而是 AppIcon.LoadWindowIcon() 从母版 PNG 现场拼出来的
            （尺寸表见 IcoFile.DefaultFrameSizes，按 DPI 1:1 出帧）；任务栏取窗口图标优先，所以那份才决定任务栏清晰度。
        -->
        <ApplicationIcon>..\Corkboard\Assets\Icons\Corkboard.ico</ApplicationIcon>
        <!--
            头程序集：版本元数据交给 git（Corkboard.GitInfoGenerator + 根 AssemblyInfo.cs），
            见 Global.props。新增平台头（移动端等）时同样打开这个开关。
        -->
        <EnableGitInfoGenerator>true</EnableGitInfoGenerator>
    </PropertyGroup>

    <Import Project="..\Platforms.props" />

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Corkboard\Corkboard.csproj" />
        <ProjectReference Include="..\Corkboard.Platforms\Corkboard.Platforms.csproj" />
        <ProjectReference Include="..\Corkboard.Platforms.Abstractions\Corkboard.Platforms.Abstractions.csproj" />
    </ItemGroup>

    <!-- 只编译与当前平台匹配的原生实现工程，与 Platforms.props 选择的 CorkboardPlatform 保持一致。 -->
    <ItemGroup Condition="'$(CorkboardPlatform)' == 'Windows'">
        <ProjectReference Include="..\Corkboard.Platforms.Windows\Corkboard.Platforms.Windows.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(CorkboardPlatform)' == 'Linux'">
        <ProjectReference Include="..\Corkboard.Platforms.Linux\Corkboard.Platforms.Linux.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(CorkboardPlatform)' == 'MacOs'">
        <ProjectReference Include="..\Corkboard.Platforms.MacOs\Corkboard.Platforms.MacOs.csproj" />
    </ItemGroup>

    <Import Project="..\Global.props" />
</Project>
