<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- ClassIsland 的 IPC 包只在官方 MyGet 源上发布。 -->
    <add key="ClassIsland" value="https://www.myget.org/F/classisland/api/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <!--
        本机开发缓存：SecRandom-C 已经把同一批 Avalonia / FluentAvalonia / ClassIsland 包展开在这里，
        作为只读 fallback 使用可以免去重复下载（约 10 GB）。换机器或 CI 上删掉这一段即可正常联网还原。
    -->
    <add key="secrandom-c-local-cache" value="D:\code\SecRandom-C\.nuget\packages" />
  </fallbackPackageFolders>
</configuration>
