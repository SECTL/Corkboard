<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- ClassIsland 的 IPC 包只在官方 MyGet 源上发布。 -->
    <add key="ClassIsland" value="https://www.myget.org/F/classisland/api/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    刻意不在这里写 fallbackPackageFolders：
    NuGet 对**不存在**的 fallback 目录是硬失败（NU1301: The local source '...' doesn't exist），
    提交一条开发机专属路径会让 CI 和别人的机器直接还原不了。
    想复用本机已有的包缓存（例如 SecRandom-C 的 .nuget/packages，约 10 GB）时，
    用机器级环境变量把它加进来即可，仓库里不留痕迹：

        setx NUGET_FALLBACK_PACKAGES "D:\code\SecRandom-C\.nuget\packages"

    清掉缓存复用：setx NUGET_FALLBACK_PACKAGES ""
  -->
</configuration>
