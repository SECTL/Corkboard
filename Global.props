<Project>
    <!--
        版本元数据由根 AssemblyInfo.cs + 头程序集承载，不用 GitVersion。
        版本号机制与上游 SecRandom-C 一致：头程序集在构建期由
        SecRandom.SimpleGitInfoGenerator（NuGet 包）跑 git describe/rev-parse，
        生成 internal 的 SecRandom.GitInfo；类库通过 GlobalConstants.SetVersionAssembly
        读取头程序集的元数据，不会出现第二个公开的 GitInfo 类型。
    -->
    <PropertyGroup>
        <GitVersion>false</GitVersion>
        <EnableGitInfoGenerator Condition="'$(EnableGitInfoGenerator)' == ''">false</EnableGitInfoGenerator>
        <!--
            非头程序集（Shared/Core/平台/测试）用 SDK 生成的程序集信息，版本取下面的 Version。
        -->
        <GenerateAssemblyInfo Condition="'$(EnableGitInfoGenerator)' != 'true'">true</GenerateAssemblyInfo>
        <Version Condition="'$(Version)' == ''">0.1.0</Version>
        <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
        <!--
            头程序集（真正的可执行入口）把版本交给 git：关掉 SDK 的程序集信息生成，
            改由根 AssemblyInfo.cs + SecRandom.SimpleGitInfoGenerator 写入
            （两者会生成同名特性，同时开启就是 CS0579）。
        -->
        <GenerateAssemblyInfo Condition="'$(EnableGitInfoGenerator)' == 'true'">false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <NullabilityInfoContextSupport>True</NullabilityInfoContextSupport>
        <ErrorOnDuplicatePublishOutputFiles>False</ErrorOnDuplicatePublishOutputFiles>
        <CheckEolWorkloads>false</CheckEolWorkloads>
        <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;publish/**</DefaultItemExcludes>
    </PropertyGroup>

    <PropertyGroup>
        <GitVersion_UpdateAssemblyInfo>true</GitVersion_UpdateAssemblyInfo>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup>
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup Condition="'$(EnableGitInfoGenerator)' == 'true'">
        <!-- 版本元数据源生成器：与上游同一个 NuGet 包，只作为 analyzer/targets 注入，不进输出目录。 -->
        <PackageReference Include="SecRandom.SimpleGitInfoGenerator" Version="1.0.1.3"
                          PrivateAssets="All" IncludeAssets="build;analyzers" />

        <Compile Include="$(MSBuildThisFileDirectory)AssemblyInfo.cs">
            <LinkBase>Properties</LinkBase>
        </Compile>
    </ItemGroup>

    <!--
        上游 SecRandom-C 在这里还引入了 Microsoft.SourceLink.GitHub，把仓库地址写进 PDB。
        Corkboard 尚未接 SourceLink；接入时在这里追加 PackageReference 即可。
    -->
</Project>
