<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             x:Class="Corkboard.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferSystemTheme="True"
                                     UseSystemFontOnWindows="False"
                                     TextVerticalAlignmentOverrideBehavior="Disabled" />
        <StyleInclude Source="/Styles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <!-- 图标字体：Core 层的 FluentIconSource 与导航项都依赖这个键。 -->
        <FontFamily x:Key="FluentSystemIconsResizeable">avares://Corkboard/Assets/Fonts/#FluentSystemIcons-Resizable</FontFamily>
        <FontFamily x:Key="AppFontFamily">avares://Corkboard/Assets/Fonts/#FluentSystemIcons-Resizable</FontFamily>
        <FontWeight x:Key="AppFontWeight">Normal</FontWeight>
    </Application.Resources>
</Application>
