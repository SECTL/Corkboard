<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             x:Class="Corkboard.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferSystemTheme="True"
                                     UseSystemFontOnWindows="False"
                                     TextVerticalAlignmentOverrideBehavior="Disabled" />
        <StyleInclude Source="/Styles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <!--
            应用字体：MiSans（小米 HyperOS 系统字体，随包分发，10 个字重）。
            ContentControlThemeFontFamily 是 FluentAvalonia/Avalonia 控件主题取字体的键，
            覆盖它才算真正换掉全应用默认字体；AppFontFamily 供页面与自定义样式引用，两者必须同值。
            字体来源与许可见 Assets/Fonts/MiSans/。
        -->
        <FontFamily x:Key="AppFontFamily">avares://Corkboard/Assets/Fonts/MiSans/#MiSans</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://Corkboard/Assets/Fonts/MiSans/#MiSans</FontFamily>
        <FontWeight x:Key="AppFontWeight">Normal</FontWeight>

        <!-- 图标字体：Core 层的 FluentIconSource 与导航项都依赖这个键，不要指向应用字体。 -->
        <FontFamily x:Key="FluentSystemIconsResizeable">avares://Corkboard/Assets/Fonts/#FluentSystemIcons-Resizable</FontFamily>
    </Application.Resources>
</Application>
