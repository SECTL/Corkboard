<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corkboard.ViewModels.Actions"
             xmlns:lac="using:Corkboard.Langs.Action"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="600"
             x:Class="Corkboard.Views.Actions.ActionWeekView"
             x:DataType="vm:ActionWindowViewModel">
    <!--
        周视图 = 时间轴 + 七列：左边 56px 时刻栏，上面七列星期表头，下面 7 × 24 小时的滚动区。
        日程块的位置与高度、重叠时并排的两列、装不下的「+N」都由 code-behind 按开始/结束时刻算
        （见 ActionWeekView.axaml.cs），XAML 只给容器与表头。
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.week-day">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.week-day.today">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.week-week">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
        <!-- 导航条。 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="mini" Command="{Binding PrevWeekCommand}">
                <Path Data="M 6,1 L 1,6 L 6,11"
                      Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
            </Button>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       Text="{Binding WeekTitle}" />
            <Button Grid.Column="2" Classes="mini" Command="{Binding NextWeekCommand}">
                <Path Data="M 1,1 L 6,6 L 1,11"
                      Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
            </Button>

            <Button Grid.Column="4" Classes="chip" Command="{Binding ThisWeekCommand}"
                    Content="{x:Static lac:Resources.Action_Week_Today}" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Classes="caption" Text="{x:Static lac:Resources.Action_Legend_Mine}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Classes="caption" Text="{x:Static lac:Resources.Action_Legend_System}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 表头：左边留出时刻栏的宽度，右边七列与内容区一一对齐。 -->
        <Grid Grid.Row="1" ColumnDefinitions="56,*">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionWeekColumn">
                        <StackPanel Spacing="1" Margin="0,0,0,4">
                            <TextBlock Classes="week-week" Text="{Binding HeaderText}" />
                            <TextBlock Classes="week-day" Classes.today="{Binding IsToday}"
                                       Text="{Binding DayText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 时间轴主体：行由 code-behind 生成（时刻栏 + 7 个 Canvas + 日程块）。 -->
        <Panel Grid.Row="2">
            <ScrollViewer x:Name="WeekScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="WeekBody" ColumnDefinitions="56,*" />
            </ScrollViewer>

            <TextBlock IsVisible="{Binding IsWeekEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Classes="caption" Text="{x:Static lac:Resources.Action_Week_Empty}" />
        </Panel>
    </Grid>
</UserControl>
