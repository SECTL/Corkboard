<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corkboard.ViewModels.Actions"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:lac="using:Corkboard.Langs.Action"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="600"
             x:Class="Corkboard.Views.Actions.ActionListView"
             x:DataType="vm:ActionWindowViewModel">
    <!--
        列表页：系统日程组在前（只读投影）、我的行动组在后。
        表头与数据行共用同一组列宽（56/*/120/170/190/84），否则两边会错位。
    -->
    <UserControl.Styles>
        <Style Selector="Border.list-header">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,0,6,8" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.row">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <!-- 最近结果的小胶囊：状态色只做点缀，文案本身已经说清结果。 -->
        <Style Selector="Button.pill">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.success">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.partial">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.failed">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.skipped">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- 历史记录浮层（必须用 Popup：Flyout 里的 DataContext 不继承、命令会静默失效）。 -->
        <Style Selector="Border.history-popup">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #33000000" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="ActionRowTemplate" x:DataType="vm:ActionOccurrenceItem">
            <Border Classes="row" Opacity="{Binding RowOpacity}"
                    PointerPressed="OnRowPressed"
                    ToolTip.Tip="{Binding EffectText}">
                <Grid ColumnDefinitions="56,*,120,170,190,84" ColumnSpacing="8" VerticalAlignment="Center">

                    <!-- 启用：自定义行动是开关，系统日程是只读的日历图标（今天暂停时换成灰字标记）。 -->
                    <Panel Grid.Column="0">
                        <ToggleSwitch IsVisible="{Binding IsRule}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{x:Static lac:Resources.Action_Field_Enabled}" />
                        <Panel IsVisible="{Binding IsSystem}" VerticalAlignment="Center">
                            <TextBlock IsVisible="{Binding !IsPausedToday}" Classes="header"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       Text="{x:Static icons:FluentIcons.CalendarFilled}"
                                       ToolTip.Tip="{x:Static lac:Resources.Action_System_ReadOnly}" />
                            <TextBlock IsVisible="{Binding IsPausedToday}" HorizontalAlignment="Center"
                                       FontSize="10" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{x:Static lac:Resources.Action_System_TodayPaused}" />
                        </Panel>
                    </Panel>

                    <!-- 名称 + 条件（第二行：触发摘要 / 生效范围 / 系统日程的下一次）。 -->
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="caption" Text="{Binding TriggerText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding ConditionText}"
                                       IsVisible="{Binding HasCondition}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 功能：这条行动会动哪几块板子。 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasTargets}">
                        <TextBlock Classes="header"
                                   FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                   Text="{x:Static icons:FluentIcons.BoardFilled}" FontSize="12" />
                        <TextBlock Text="{Binding TargetsText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 执行：显 / 隐那几句话，一行截断，全文进 ToolTip。 -->
                    <TextBlock Grid.Column="3" Text="{Binding EffectText}" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 最近结果：胶囊 + 相对时间，点开是最近 10 条记录。 -->
                    <Panel Grid.Column="4">
                        <Button Classes="pill"
                                Command="{Binding $parent[UserControl].((vm:ActionWindowViewModel)DataContext).ToggleHistoryCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{x:Static lac:Resources.Action_RunHistory_Show}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot"
                                         Classes.success="{Binding IsResultSuccess}"
                                         Classes.partial="{Binding IsResultPartial}"
                                         Classes.failed="{Binding IsResultFailed}"
                                         Classes.skipped="{Binding IsResultSkipped}" />
                                <TextBlock Text="{Binding ResultText}" FontSize="12" />
                                <TextBlock Classes="caption" Text="{Binding ResultTimeText}" />
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding $parent[Panel]}"
                               Placement="Bottom"
                               HorizontalOffset="0" VerticalOffset="4"
                               Closed="OnHistoryPopupClosed">
                            <Border Classes="history-popup" Width="340">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="section-title"
                                               Text="{x:Static lac:Resources.Action_RunHistory_Title}" />
                                    <TextBlock Classes="caption"
                                               Text="{x:Static lac:Resources.Action_RunHistory_Empty}"
                                               IsVisible="{Binding !HasRecentRuns}" />
                                    <ItemsControl ItemsSource="{Binding RecentRuns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActionRunViewItem">
                                                <StackPanel Spacing="2" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Classes="dot"
                                                                 Classes.success="{Binding IsSuccess}"
                                                                 Classes.partial="{Binding IsPartial}"
                                                                 Classes.failed="{Binding IsFailed}"
                                                                 Classes.skipped="{Binding IsSkipped}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Classes="caption" Text="{Binding SourceText}" />
                                                        <TextBlock Classes="caption" Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DetailText}" FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>

                    <!-- 操作：自定义 = 编辑 + 立即执行；系统日程 = 进详情卡改参数 + 今天不执行。 -->
                    <Panel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsRule}">
                            <Button Classes="mini"
                                    Command="{Binding $parent[UserControl].((vm:ActionWindowViewModel)DataContext).EditCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{x:Static lac:Resources.Action_Edit}"
                                    AutomationProperties.Name="{x:Static lac:Resources.Action_Edit}">
                                <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.EditFilled}" />
                            </Button>
                            <Button Classes="mini"
                                    Command="{Binding $parent[UserControl].((vm:ActionWindowViewModel)DataContext).RunNowCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{x:Static lac:Resources.Action_Run_Now}"
                                    AutomationProperties.Name="{x:Static lac:Resources.Action_Run_Now}">
                                <!-- 仓库图标表里没有 Play 字形，用 Path 画一颗三角。 -->
                                <Path Data="M 1,1 L 9,5 L 1,9 Z"
                                      Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsSystem}">
                            <Button Classes="mini"
                                    Command="{Binding $parent[UserControl].((vm:ActionWindowViewModel)DataContext).EditCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}">
                                <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.SettingsFilled}" />
                            </Button>
                            <Button Classes="mini"
                                    IsVisible="{Binding CanPause}"
                                    Command="{Binding $parent[UserControl].((vm:ActionWindowViewModel)DataContext).PauseTodayCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding PauseTodayText}"
                                    AutomationProperties.Name="{Binding PauseTodayText}">
                                <Path Data="M 0,0 L 3,0 L 3,10 L 0,10 Z M 6,0 L 9,0 L 9,10 L 6,10 Z"
                                      Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 表头（与数据行同一组 ColumnDefinitions）。 -->
        <Border Grid.Row="0" Classes="list-header">
            <Grid ColumnDefinitions="56,*,120,170,190,84" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="header" HorizontalAlignment="Center"
                           Text="{x:Static lac:Resources.Action_Column_Enabled}" />
                <TextBlock Grid.Column="1" Classes="header"
                           Text="{x:Static lac:Resources.Action_Column_Condition}" />
                <TextBlock Grid.Column="2" Classes="header"
                           Text="{x:Static lac:Resources.Action_Column_Target}" />
                <TextBlock Grid.Column="3" Classes="header"
                           Text="{x:Static lac:Resources.Action_Column_Effect}" />
                <TextBlock Grid.Column="4" Classes="header"
                           Text="{x:Static lac:Resources.Action_Column_Result}" />
                <TextBlock Grid.Column="5" Classes="header" HorizontalAlignment="Right"
                           Text="{x:Static lac:Resources.Action_Column_Actions}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,0">
            <Panel>
                <StackPanel Spacing="2">
                    <StackPanel IsVisible="{Binding HasSystemItems}" Spacing="2">
                        <TextBlock Classes="group-title" Text="{x:Static lac:Resources.Action_Group_System}" />
                        <ItemsControl ItemsSource="{Binding SystemItems}"
                                      ItemTemplate="{StaticResource ActionRowTemplate}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasMyItems}" Spacing="2">
                        <TextBlock Classes="group-title" Text="{x:Static lac:Resources.Action_Group_Mine}" />
                        <ItemsControl ItemsSource="{Binding MyItems}"
                                      ItemTemplate="{StaticResource ActionRowTemplate}" />
                    </StackPanel>
                </StackPanel>

                <!-- 空态：一句说明 + 三颗示例（点开就是预填的编辑器，不落盘）。 -->
                <StackPanel IsVisible="{Binding IsListEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="14" Margin="0,48,0,48" MaxWidth="460">
                    <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                               Text="{x:Static icons:FluentIcons.CalendarFilled}"
                               FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Classes="h2" HorizontalAlignment="Center"
                               Text="{x:Static lac:Resources.Action_Empty_Title}" />
                    <TextBlock Classes="caption" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Text="{x:Static lac:Resources.Action_Empty_Hint}" />

                    <StackPanel Spacing="8" IsVisible="{Binding ShowExamples}">
                        <Button Classes="chip" HorizontalAlignment="Center"
                                Command="{Binding NewExampleCommand}" CommandParameter="daily"
                                Content="{x:Static lac:Resources.Action_Example_1}" />
                        <Button Classes="chip" HorizontalAlignment="Center"
                                Command="{Binding NewExampleCommand}" CommandParameter="weekly"
                                Content="{x:Static lac:Resources.Action_Example_2}" />
                        <Button Classes="chip" HorizontalAlignment="Center"
                                Command="{Binding NewExampleCommand}" CommandParameter="once"
                                Content="{x:Static lac:Resources.Action_Example_3}" />
                    </StackPanel>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
