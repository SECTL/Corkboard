<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corkboard.ViewModels.Actions"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:lac="using:Corkboard.Langs.Action"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="640"
             x:Class="Corkboard.Views.Actions.ActionEditorView"
             x:DataType="vm:ActionEditorViewModel">
    <!--
        规则编辑器（弹层卡片）：遮罩由 ActionWindow 的 overlay 宿主画，这里只有卡片本身。
        只有顶栏能拖动（整卡拖动容易误触，触屏更甚）；拖动实现见 code-behind。
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Button.weekday">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.step-row">
            <Setter Property="Padding" Value="0,2" />
        </Style>
        <Style Selector="Border.error-block">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.warning-block">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="Card" Classes="sheet" Width="560" MaxHeight="660">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <!-- 顶栏：唯一的拖动面。 -->
            <Grid x:Name="SheetHeader" Grid.Row="0" ColumnDefinitions="*,Auto"
                  Background="Transparent" Cursor="SizeAll"
                  PointerPressed="OnHeaderPressed"
                  ToolTip.Tip="{x:Static lac:Resources.Action_Editor_DragHint}">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding Title}" />
                    <TextBlock Classes="caption" Text="{x:Static lac:Resources.Action_Editor_DragHint}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="mini" Command="{Binding CancelCommand}"
                        ToolTip.Tip="{x:Static lac:Resources.Action_Cancel}"
                        AutomationProperties.Name="{x:Static lac:Resources.Action_Cancel}">
                    <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                               Text="{x:Static icons:FluentIcons.DismissRegular}" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- 名称。 -->
                    <StackPanel>
                        <TextBlock Classes="field-label" Text="{x:Static lac:Resources.Action_Field_Name}" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}" MaxLength="40"
                                 PlaceholderText="{x:Static lac:Resources.Action_Field_NamePlaceholder}" />
                    </StackPanel>

                    <!-- 启用。 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                   Text="{x:Static lac:Resources.Action_Field_Enabled}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- 触发方式 + 时刻。 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="field-label" Text="{x:Static lac:Resources.Action_Field_Trigger}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding TriggerOptions}"
                                      SelectedIndex="{Binding TriggerKindIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="field-label" Text="{x:Static lac:Resources.Action_Field_Time}" />
                            <TimePicker ClockIdentifier="24HourClock"
                                        SelectedTime="{Binding TriggerTime, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- 单次的日期。 -->
                    <StackPanel IsVisible="{Binding IsOnce}">
                        <TextBlock Classes="field-label" Text="{x:Static lac:Resources.Action_Field_Date}" />
                        <CalendarDatePicker HorizontalAlignment="Stretch"
                                            SelectedDate="{Binding TriggerDate, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 每周的星期。 -->
                    <StackPanel IsVisible="{Binding IsWeekly}">
                        <TextBlock Classes="field-label" Text="{x:Static lac:Resources.Action_Field_Weekdays}" />
                        <WrapPanel Orientation="Horizontal">
                            <ToggleButton Classes="weekday" Margin="0,0,6,0"
                                          IsChecked="{Binding WeekdayMonday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Monday}" />
                            <ToggleButton Classes="weekday" Margin="0,0,6,0"
                                          IsChecked="{Binding WeekdayTuesday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Tuesday}" />
                            <ToggleButton Classes="weekday" Margin="0,0,6,0"
                                          IsChecked="{Binding WeekdayWednesday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Wednesday}" />
                            <ToggleButton Classes="weekday" Margin="0,0,6,0"
                                          IsChecked="{Binding WeekdayThursday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Thursday}" />
                            <ToggleButton Classes="weekday" Margin="0,0,6,0"
                                          IsChecked="{Binding WeekdayFriday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Friday}" />
                            <ToggleButton Classes="weekday" Margin="0,0,6,0"
                                          IsChecked="{Binding WeekdaySaturday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Saturday}" />
                            <ToggleButton Classes="weekday"
                                          IsChecked="{Binding WeekdaySunday, Mode=TwoWay}"
                                          Content="{x:Static lac:Resources.Action_Weekday_Sunday}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- 生效日期范围（可选）。 -->
                    <StackPanel>
                        <TextBlock Classes="field-label" Text="{x:Static lac:Resources.Action_Field_Range}" />
                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                            <CalendarDatePicker Grid.Column="0" HorizontalAlignment="Stretch"
                                                SelectedDate="{Binding RangeStart, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="–"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <CalendarDatePicker Grid.Column="2" HorizontalAlignment="Stretch"
                                                SelectedDate="{Binding RangeEnd, Mode=TwoWay}" />
                            <Button Grid.Column="3" Classes="mini" Command="{Binding ClearRangeCommand}"
                                    ToolTip.Tip="{x:Static lac:Resources.Action_ClearRange}">
                                <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.DismissRegular}" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="caption" Margin="0,4,0,0"
                                   Text="{x:Static lac:Resources.Action_Field_RangeHint}" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 行动步骤。 -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="field-label" Margin="0"
                                       Text="{x:Static lac:Resources.Action_Field_Steps}" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding StepCountText}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionStepRow">
                                    <Border Classes="step-row">
                                        <Grid ColumnDefinitions="*,150,28" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding $parent[UserControl].((vm:ActionEditorViewModel)DataContext).TargetOptions}"
                                                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                      ToolTip.Tip="{x:Static lac:Resources.Action_Step_Target}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ActionTargetOption">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   IsEnabled="{Binding IsAvailable}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding $parent[UserControl].((vm:ActionEditorViewModel)DataContext).OperationOptions}"
                                                      SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                                                      ToolTip.Tip="{x:Static lac:Resources.Action_Step_Operation}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ActionOperationOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Grid.Column="2" Classes="mini"
                                                    Command="{Binding $parent[UserControl].((vm:ActionEditorViewModel)DataContext).RemoveStepCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{x:Static lac:Resources.Action_Step_Remove}"
                                                    AutomationProperties.Name="{x:Static lac:Resources.Action_Step_Remove}">
                                                <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                           Text="{x:Static icons:FluentIcons.DeleteFilled}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="chip" Command="{Binding AddStepCommand}"
                                    IsEnabled="{Binding CanAddStep}"
                                    Content="{x:Static lac:Resources.Action_Step_Add}" />
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static lac:Resources.Action_Editor_MaxSteps}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{x:Static lac:Resources.Action_OverlapHint}" />

                    <Border Classes="error-block" IsVisible="{Binding HasErrors}">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                    <Border Classes="warning-block" IsVisible="{Binding HasWarnings}">
                        <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部：删除（仅编辑态）· 取消 · 保存。 -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="chip" IsVisible="{Binding CanDelete}"
                        Command="{Binding RequestDeleteCommand}"
                        Content="{x:Static lac:Resources.Action_Delete}" />
                <Button Grid.Column="2" Content="{x:Static lac:Resources.Action_Cancel}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="3" Classes="accent"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                        Content="{x:Static lac:Resources.Action_Save}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
