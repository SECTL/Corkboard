<faWindowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:faWindowing="using:FluentAvalonia.UI.Windowing"
                         xmlns:fa="using:FluentAvalonia.UI.Controls"
                         xmlns:core="using:Corkboard.Core.Langs.Common"
                         xmlns:icons="using:Corkboard.Core.Icons"
                         xmlns:vm="using:Corkboard.ViewModels.DutyRoster"
                         mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
                         x:Class="Corkboard.Views.Duty.DutyRosterWindow"
                         x:DataType="vm:DutyRosterViewModel"
                         Title="{x:Static core:Resources.Duty_Roster_Title}"
                         Width="1280" Height="820"
                         MinWidth="960" MinHeight="640"
                         WindowStartupLocation="CenterScreen">
    <!--
        值日表窗口：上面是 FACommandBar 工具栏（翻页 / 今天 / 周月切换 / 设置 / 节假日），
        中间是 DataGrid 画的周表或月历，右侧是某一天的详情抽屉。

        表格用 Avalonia 官方 DataGrid（包在 Corkboard.csproj 里，Fluent 样式在 Styles.axaml 引入）：
        「现成组件」是用户明确要求的形态——排序、列宽、选中、键盘导航都白拿，不用自己拿 Border 拼。
        列头文字在 code-behind 里赋（周视图要写「周一 11/10」这种「星期 + 月/日」，绑定做不了这么细）。
    -->
    <faWindowing:FAAppWindow.Resources>
        <!-- 周视图的一格：姓名（顿号分隔）+ 徽标（固 / 换 / 加）。七列共用同一份模板。 -->
        <DataTemplate x:Key="WeekCellTemplate" x:DataType="vm:DutyWeekCell">
            <Border Classes="duty-cell"
                    Classes.off="{Binding IsOff}"
                    Tapped="OnDayTapped">
                <Grid RowDefinitions="*,Auto">
                    <TextBlock Grid.Row="0"
                               FontSize="13"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Classes="cell-badge"
                               Text="{Binding Badge}"
                               IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 月视图的一格：日期 + 值日小组 + 徽标，今天 / 非本月 / 不值日各有淡化或描边。 -->
        <DataTemplate x:Key="MonthCellTemplate" x:DataType="vm:DutyMonthCell">
            <Border Classes="month-cell"
                    Classes.outside="{Binding IsOutside}"
                    Classes.off="{Binding IsOff}"
                    Classes.today="{Binding IsToday}"
                    Tapped="OnDayTapped">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Classes="month-day" Text="{Binding DayText}" />
                    <TextBlock Grid.Row="1" Classes="month-group" Text="{Binding GroupName}" />
                    <TextBlock Grid.Row="2"
                               Classes="cell-badge"
                               Text="{Binding Badge}"
                               IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </faWindowing:FAAppWindow.Resources>

    <faWindowing:FAAppWindow.Styles>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="TextBlock.duty-row-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.duty-row-title.group">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.duty-cell">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style Selector="Border.duty-cell:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.duty-cell.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.month-cell">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="72" />
        </Style>
        <Style Selector="Border.month-cell:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.month-cell.outside">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.month-cell.off">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.month-cell.today">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.month-day">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.month-group">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.cell-badge">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </faWindowing:FAAppWindow.Styles>

    <Grid>
        <Grid Margin="20,12,20,16" RowDefinitions="Auto,Auto,*" RowSpacing="12">

            <!-- 顶部：标题 + 一句说明（真实标题住在这扇窗的标题栏上，内容区不再重复大标题）。 -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static core:Resources.Duty_Roster_Title}" />
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static core:Resources.Duty_Roster_Description}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 工具栏：一条 FACommandBar（翻页 / 今天 / 周月切换 / 设置 / 节假日），右侧跟范围与模式。 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <fa:FACommandBar Grid.Column="0"
                                     ClosedDisplayMode="Hidden"
                                     DefaultLabelPosition="Right">
                        <fa:FACommandBar.PrimaryCommands>
                            <fa:FACommandBarButton Label="上一页" Command="{Binding PreviousCommand}" />
                            <fa:FACommandBarButton Label="今天" Command="{Binding TodayCommand}" />
                            <fa:FACommandBarButton Label="下一页" Command="{Binding NextCommand}" />
                            <fa:FACommandBarSeparator />
                            <fa:FACommandBarButton Label="周视图" Command="{Binding ShowWeekCommand}" />
                            <fa:FACommandBarButton Label="月视图" Command="{Binding ShowMonthCommand}" />
                            <fa:FACommandBarSeparator />
                            <fa:FACommandBarButton Label="设置" Click="OnOpenSettingsClick" />
                            <fa:FACommandBarButton Label="节假日" Click="OnOpenHolidaysClick" />
                        </fa:FACommandBar.PrimaryCommands>
                    </fa:FACommandBar>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding RangeText}"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10"
                                Padding="8,2">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ModeText}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <!-- 周视图：第一列「职务 / 值日小组」，后 7 列周一..周日。列头由 code-behind 赋「周一 11/10」。 -->
                <DataGrid x:Name="WeekGrid"
                          Grid.Column="0"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          IsVisible="{Binding IsWeekView}"
                          ItemsSource="{Binding WeekRows}"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="职务 / 星期" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <TextBlock Classes="duty-row-title"
                                               Classes.group="{Binding IsGroupRow}"
                                               Text="{Binding Title}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day1}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day2}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day3}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day4}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day5}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day6}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekRow">
                                    <ContentControl Content="{Binding Day7}"
                                                    ContentTemplate="{StaticResource WeekCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 月视图：7 列 × 6 行，一行就是一周。列头由 code-behind 按「周起始日」赋。 -->
                <DataGrid x:Name="MonthGrid"
                          Grid.Column="0"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          IsVisible="{Binding !IsWeekView}"
                          ItemsSource="{Binding MonthRows}"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week1}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week2}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week3}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week4}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week5}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week6}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMonthRow">
                                    <ContentControl Content="{Binding Week7}"
                                                    ContentTemplate="{StaticResource MonthCellTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 一个小组都没有时的引导卡：别让用户对着空表猜。 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding IsSetupRequired}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                   FontSize="30"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{x:Static icons:FluentIcons.PeopleFilled}" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="还没有建小组" />
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="先到设置里把名单导进来、分好小组和职务，这里就会出现排班。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Center"
                                Click="OnOpenSettingsClick"
                                Content="打开设置" />
                    </StackPanel>
                </Border>

                <!-- 日详情抽屉：点周表格或月历的某一天打开。 -->
                <Border Grid.Column="1"
                        Width="320"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding IsDayPanelOpen}">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="14,12,14,12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedDateText}" />
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedGroupText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CloseDayPanelCommand}"
                                    Padding="6"
                                    VerticalAlignment="Top">
                                <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           FontSize="12"
                                           Text="{x:Static icons:FluentIcons.DismissRegular}" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding DayEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DutyDayDetailEntry">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                            <TextBlock Grid.Column="0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding PostName}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="13"
                                                       Text="{Binding MemberName}" />
                                            <TextBlock Grid.Column="2"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Badge}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Margin="0,0,6,6"
                                    Click="OnToggleDayOffClick"
                                    Content="{Binding DayOverrideButtonText}" />
                            <Button Margin="0,0,6,6" Click="OnAssignGroupClick" Content="指定小组" />
                            <Button Margin="0,0,6,6" Click="OnGroupSwapClick" Content="小组对调" />
                            <Button Margin="0,0,6,6" Click="OnGroupPenaltyClick" Content="小组加罚" />
                            <Button Margin="0,0,6,6" Click="OnPersonSwapClick" Content="个人兑换" />
                            <Button Margin="0,0,6,6" Click="OnPersonAddClick" Content="个人增设" />
                        </WrapPanel>

                        <TextBlock Grid.Row="3"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding SelectedHintText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--
            弹层宿主：值日表窗口里的表单（排班调整、临时换班……）要画在**这扇窗**里。
            弹层服务只有一个，默认落点是主窗口；不在这里注册宿主，「点开表单什么都不发生」——
            表单跑到被这扇窗挡住的作业板主窗口上去了。层级用全屏宿主那一档，压过壳。
        -->
        <Border x:Name="OverlayScrim" Classes="scrim" IsVisible="False">
            <ContentControl x:Name="OverlayContentHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
    </Grid>
</faWindowing:FAAppWindow>
