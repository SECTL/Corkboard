<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corkboard.ViewModels.MainPages"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:controls="using:Corkboard.Core.Controls"
             xmlns:rte="using:AvaloniaRichEditor.Controls"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="520"
             x:Class="Corkboard.Views.MainPages.BoardAssignmentForm"
             x:DataType="vm:BoardAssignmentFormViewModel">
    <UserControl.Styles>
        <!--
            作业内容框：所见即所得编辑区的外壳。
            比卡片背景浅一档、带一圈描边，一眼看出这里可以点、点了能写字；
            编辑控件与工具栏都不画底色，框的圆角、内边距由这层壳决定。
        -->
        <Style Selector="Border.content-box">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!--
            卡片：宽度有下限也有上限；高度上限按「看得见的宿主」算——壳内弹层用窗口内容区、
            独立窗口（SizeToContent）用屏幕工作区，都只占其 70%（见 code-behind 的 ApplySheetSizeLimits）。
            内容比上限还高时卡片自己滚动，不会把窗口一直撑下去，也不会长成一条竖长的板子。
            ⚠️ 整张卡片标 WindowDragGesture.Suppress：卡片的手势归表单自己，壳的整窗长按拖动让出去
            （壳在弹层打开时本来就已让出，这里是显式声明，别删）。
        -->
        <Border Classes="sheet"
                x:Name="Sheet"
                MinWidth="380"
                MaxWidth="720"
                controls:WindowDragGesture.Suppress="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SheetBody" Spacing="12">
                    <!--
                        卡片没有标题栏：第一行就是表单标题（布置作业 / 编辑作业）。
                        **整张卡片都是拖动面**——按住卡片上任何非输入控件的地方都能把它拖走，
                        所以标题行不再放抓手图标：那是「只有这里能拖」的暗示，反而让人以为别处拖不动。
                        光标与提示留在标题行上，作为「能动」的唯一提示（见 code-behind 的 OnSheetPressed）。
                    -->
                    <TextBlock Classes="h2"
                               Background="Transparent"
                               Cursor="SizeAll"
                               ToolTip.Tip="{x:Static core:Resources.Board_MoveSheet}"
                               Text="{Binding FormTitle}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   Text="{x:Static core:Resources.Board_TypeLabel}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TypeOptions}"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoardTypeOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                   Text="{x:Static core:Resources.Board_SubjectLabel}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SubjectOptions}"
                                  SelectedItem="{Binding DraftSubject, Mode=TwoWay}"
                                  PlaceholderText="{x:Static core:Resources.Board_SubjectLabel}" />
                    </Grid>

                    <!--
                        截止日期：不填就是不设，填了就以它为准（判过期时它优先于设置里的「保留天数」）。
                        用 Avalonia 自带的 CalendarDatePicker 点一下挑日历，省事，也不会再出现
                        「2 月 31 日」这种要靠夹才能收场的非法输入。
                        选择器自己没地方把已挑的日期退回空值（点日历只会换一天），
                        所以「不设截止日期」这个状态得由旁边那个清除按钮给。
                        ⚠️ 它是 TemplatedControl，不在「按住卡片拖动」的排除表里，必须自己加进去
                        （见 code-behind 的 IsInteractiveSource），否则按在它身上会被当成拖卡片。
                    -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   Text="{x:Static core:Resources.Settings_Board_DueDate}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <CalendarDatePicker VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                PlaceholderText="{x:Static core:Resources.Settings_Board_DueDateNone}"
                                                SelectedDate="{Binding DueDateDraft, Mode=TwoWay}"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Board_DueDateDescription}" />
                            <Button VerticalAlignment="Center"
                                    IsVisible="{Binding HasDueDate}"
                                    Command="{Binding ClearDueDateCommand}"
                                    Content="{x:Static core:Resources.Settings_Board_DueDateClear}" />
                        </StackPanel>
                    </Grid>

                    <!--
                        作业内容：**一个框**，而且一直是所见即所得的富文本编辑区——没有 Markdown 原文态，
                        写到什么样子板子上就是什么样子（加粗、标题、列表都由编辑控件自己画）。
                        格式工具栏常驻在编辑区正上方（库自带的 RichEditorToolbar，Target 由 code-behind
                        指到 ContentEditor）：加粗/斜体/字号/颜色这些点一下就对选中的文字生效；
                        卡片上不放任何常驻控件，那儿只是显示。
                        两个尺寸都写死（而不是跟内容自适应），因为「能手动拉」这件事本身就要求尺寸是用户定的；
                        能拉多大由 code-behind 的 ResolveContentSizeLimit 算，右下角手柄拉的是整个区块。
                        Grid 跟着内容区走（HorizontalAlignment=Left），手柄才会贴在区块右下角而不是卡片右下角。
                    -->
                    <Grid x:Name="ContentArea"
                          Width="540"
                          Height="300"
                          MinWidth="340"
                          MinHeight="150"
                          HorizontalAlignment="Left">
                        <Border x:Name="ContentBoxChrome"
                                Classes="content-box"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                <!--
                                    工具栏常驻在编辑框上方。Target 在 code-behind 里指过去（工具栏不是编辑控件的
                                    可视祖先，XAML 里绑不上）。文件菜单与页面/缩放控件都关掉：这是便签，不是打印稿；
                                    它自带的文案只有英文/韩文，中文表也在 code-behind 里注册。
                                -->
                                <rte:RichEditorToolbar Grid.Row="0"
                                                       x:Name="EditorToolbar"
                                                       ToolbarLevel="Normal"
                                                       ShowFileActions="False"
                                                       ShowPageControls="False"
                                                       Focusable="False" />

                                <Grid Grid.Row="1">
                                    <!--
                                        编辑区。默认字号 / 默认颜色由控件在装载时补成行内样式（见 RichTextBlock），
                                        回写进 DraftHtml 的是摘掉这层样式之后的干净 HTML，可以原样落盘。
                                        标题栏与页面边框都关掉：这是便签，不是打印稿。
                                        ⚠️ AllowTables="False"：作业内容不要表格。库的工具栏是看
                                        Target.AllowTables 决定那个「插入表格」按钮显不显示的（RichEditorToolbar.cs:1876-1886），
                                        关掉它同时也挡住 InsertTable / InsertInlineTable 与「粘贴制表符文本自动转表格」，
                                        **但只是不让新建**——已经存在表格的旧作业照样正常显示（渲染路径不看这个开关）。
                                        控件自己不滚动也不裁剪（它把整篇一次画出来），所以外面必须套一层滚动条，
                                        否则内容一长就压到卡片其它地方去了；宽度也得有约束，默认按整张 A4 纸宽排。
                                    -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Cursor="IBeam">
                                        <controls:RichTextBlock x:Name="ContentEditor"
                                                                IsReadOnly="False"
                                                                AllowTables="False"
                                                                ShowFormattingMenu="False"
                                                                ShowPageBoundaries="False"
                                                                ShowPageNumbers="False"
                                                                Html="{Binding DraftHtml, Mode=TwoWay}"
                                                                DefaultContentFontSize="{Binding BaseFontSize}"
                                                                DefaultContentColor="{Binding BaseColor}" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="ResizeGrip"
                                Width="18"
                                Height="18"
                                Margin="0 0 3 3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                Cursor="BottomRightCorner"
                                ToolTip.Tip="{x:Static core:Resources.Board_ResizeContent}"
                                PointerPressed="OnResizeGripPressed"
                                PointerMoved="OnResizeGripMoved"
                                PointerReleased="OnResizeGripReleased"
                                PointerCaptureLost="OnResizeGripCaptureLost">
                            <Path Data="M7,15 L15,7 M11,15 L15,11"
                                  Stroke="#88909090"
                                  StrokeThickness="1.2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" />
                        </Border>
                    </Grid>

                    <!-- 字段控件全部用 Avalonia 自带控件：数字与页数用 NumericUpDown。 -->
                    <ItemsControl x:Name="FieldList" ItemsSource="{Binding DraftFields}" IsVisible="{Binding HasDraftFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:BoardTextFieldDraft">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                    <TextBox MinWidth="140" Text="{Binding Text, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:BoardParagraphFieldDraft">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBox MinWidth="300"
                                             MinHeight="56"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding Text, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:BoardNumberFieldDraft">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                    <NumericUpDown MinWidth="110"
                                                   Minimum="0"
                                                   Maximum="9999"
                                                   Increment="1"
                                                   FormatString="0"
                                                   Value="{Binding Value, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:BoardPageRangeFieldDraft">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                    <NumericUpDown MinWidth="100"
                                                   Minimum="1"
                                                   Maximum="9999"
                                                   Increment="1"
                                                   FormatString="0"
                                                   Value="{Binding From, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" Text="–" />
                                    <NumericUpDown MinWidth="100"
                                                   Minimum="1"
                                                   Maximum="9999"
                                                   Increment="1"
                                                   FormatString="0"
                                                   Value="{Binding To, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!--
                        底部动作行。它是「卡片高度上限」里必须留出来的那一块（见 ResolveContentSizeLimit）：
                        算上限时逐个量这行与其它行的实际高度，不靠「整高减内容区」倒推。
                    -->
                    <StackPanel x:Name="FooterActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Command="{Binding CancelCommand}"
                                Content="{x:Static core:Resources.Common_Cancel}" />
                        <Button Command="{Binding ConfirmCommand}"
                                IsEnabled="{Binding CanConfirm}"
                                Content="{Binding ConfirmText}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Panel>
</UserControl>
