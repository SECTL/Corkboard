<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Corkboard.ViewModels.MainPages"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:controls="using:Corkboard.Core.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Corkboard.Views.MainPages.BoardPage"
             x:DataType="vm:BoardPageViewModel"
             PointerMoved="OnReorderMoved"
             PointerReleased="OnReorderReleased"
             PointerCaptureLost="OnReorderCaptureLost">
    <UserControl.Resources>
        <!-- 一个科目一个区块，区块内逐条列作业；科目名只出现一次。 -->
        <DataTemplate x:Key="BoardSubjectTemplate" DataType="vm:BoardSubjectItem">
            <Border Classes="note">
                <StackPanel Spacing="8">
                    <!--
                        区块标题行整条都是拖动面：左边是排序手柄字形，右边是科目名。
                        按下即接管指针，挪动超过阈值就换位置、松手落盘——**不需要长按**：
                        手柄本身就是「抓这里拖」的意思，而且 500ms 长按正好和壳的整窗长按拖动
                        撞车（判定条件一样，同一次按住会被判成两件事）。
                        手柄只有一个小字形，用户根本找不到也不好按，所以整条标题行都能抓。
                        ⚠️ 这棵树必须标 WindowDragGesture.Suppress：壳的整窗长按拖动要让出去。
                    -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4"
                          Background="Transparent"
                          controls:WindowDragGesture.Suppress="True"
                          PointerPressed="OnReorderPressed">
                        <Border Grid.Column="0"
                                Classes="sort-handle"
                                IsVisible="{Binding CanReorder}"
                                Cursor="SizeAll"
                                ToolTip.Tip="{x:Static core:Resources.Board_ReorderSubject}">
                            <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       Text="{x:Static icons:FluentIcons.ReOrderDotsVerticalFilled}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Text="{Binding Subject}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BoardNoteItem">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="caption" IsVisible="{Binding HasDetail}"
                                                   TextWrapping="Wrap" Text="{Binding Detail}" />
                                        <!--
                                            作业内容按 Markdown 渲染，颜色/字号标注也在这里生效。
                                            列表里用不能选中的 TextBlock 而不是 SelectableTextBlock：
                                            后者会吃掉指针手势，跟壳的整窗长按拖动、区块拖动排序打架。
                                        -->
                                        <controls:MarkdownTextBlock IsVisible="{Binding HasContent}"
                                                                    TextWrapping="Wrap"
                                                                    Document="{Binding Document}" />
                                    </StackPanel>
                                    <!-- 回放期间列表项自带 CanModify=false，两个按钮随之隐藏。 -->
                                    <Button Grid.Column="1" VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                            Content="{x:Static icons:FluentIcons.EditFilled}"
                                            IsVisible="{Binding CanModify}"
                                            ToolTip.Tip="{x:Static core:Resources.Board_EditNote}"
                                            Click="OnEditNoteClick" />
                                    <Button Grid.Column="2" VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0" Padding="6"
                                            FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                            Content="{x:Static icons:FluentIcons.DeleteFilled}"
                                            IsVisible="{Binding CanModify}"
                                            ToolTip.Tip="{x:Static core:Resources.Board_DeleteNote}"
                                            Click="OnDeleteNoteClick" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- 纯文字区块，边界使用描边或分隔线。 -->
        <Style Selector="Border.note">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <!-- 抓起来 / 放下都要是「抬一下」而不是硬切，所以这几个属性走过渡。 -->
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.layout-single Border.note">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <!-- 合并后高度随内容增长，避免隐藏同科目的后续作业。 -->
        <Style Selector="ItemsControl.layout-block Border.note">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ItemsControl.layout-flow Border.note">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>
        <!--
            成排布局（区块 / 流动）里 **每个区块各自定高**。
            WrapPanel 会把同一行的项拉到行高，于是某个科目作业多了、或者内容字号大了，
            同行的其它科目也跟着被拉长——看着像「垒成一样高的一排」。VerticalAlignment=Top
            让每个区块只占自己内容的高度，行内其余位置留空；行高本身仍是这一行最高那块决定的，
            这是换行排布的固有代价，不想要就选「单列」排布。
        -->
        <Style Selector="ItemsControl.layout-single ContentPresenter,
                         ItemsControl.layout-block ContentPresenter,
                         ItemsControl.layout-flow ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--
            科目区块的排序手柄：区块标题行左边的小字形，是「抓这里拖」的手感提示。
            光标与提示挂在它身上（回放期间它整颗隐藏），真正接手势的是整条标题行。
            背景平时全透明、指针悬停才浅浅显一下。
        -->
        <Style Selector="Border.sort-handle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="2 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.sort-handle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <!-- 正被拎起来的那一块：稍稍淡一点、加一层投影，看着像离开了板面。 -->
        <Style Selector="Border.note.dragging">
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="BoxShadow" Value="0 6 16 0 #33000000" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <!--
            页面上不再有工具条：排布切换搬进「设置 → 作业板」（下拉框），
            「布置作业」与时空回放的入口都在主界面标题栏上（见 MainView）。
            这一行只剩回放提示：明确告诉用户现在看的不是实时板子。
        -->
        <TextBlock Grid.Row="0"
                   Classes="caption"
                   HorizontalAlignment="Right"
                   Margin="12 0 12 8"
                   IsVisible="{Binding IsReplaying}"
                   Text="{Binding ReplayBanner}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="12 0 12 12" Spacing="8">
                <StackPanel Spacing="4" IsVisible="{Binding !HasNotes}">
                    <TextBlock Classes="h2" Text="{x:Static core:Resources.Board_EmptyTitle}" />
                    <TextBlock Classes="caption" Text="{Binding EmptyHint}" />
                </StackPanel>

                <!--
                    回放暂停时补一句说明：这时看不到删除按钮，是因为历史快照不能改。
                -->
                <TextBlock Classes="caption"
                           IsVisible="{Binding IsReplaying}"
                           Text="{x:Static core:Resources.Board_ReplayReadOnlyHint}" />
                <ItemsControl Classes="layout-single" IsVisible="{Binding IsSingleColumnLayout}"
                              ItemsSource="{Binding SubjectGroups}" ItemTemplate="{StaticResource BoardSubjectTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl Classes="layout-block" IsVisible="{Binding IsBlockLayout}"
                              ItemsSource="{Binding SubjectGroups}" ItemTemplate="{StaticResource BoardSubjectTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="240" ItemSpacing="8" LineSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl Classes="layout-flow" IsVisible="{Binding IsFlowLayout}"
                              ItemsSource="{Binding SubjectGroups}" ItemTemplate="{StaticResource BoardSubjectTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
