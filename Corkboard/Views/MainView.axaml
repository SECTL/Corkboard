<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:enums="using:Corkboard.Core.Board"
             xmlns:views="using:Corkboard.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corkboard.Views.MainView"
             x:DataType="views:MainView"
             Header="Corkboard"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Styles>
        <!--
            标题栏右上角的动作按钮统一高度。
            Fluent 的 Button 只给最小高度，实际高度是「内容高度 + 内边距」量出来的：
            只有图标字形的（设置）、只有文字的（布置作业）、图标+文字的（时空回放 / 退出回放）
            三种内容各自量出来都不一样，不统一就会高矮不齐。
        -->
        <Style Selector="StackPanel.titlebar-actions Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </ContentPage.Styles>
    <Panel>
        <Grid RowDefinitions="Auto *">
            <!--
                自定义标题栏：拖动区域与交互元素必须显式声明 ElementRole。
                标题栏按下即拖（见 MainView.OnPointerPressedForDrag），所以里面的按钮一律标 User，
                否则按下会被判成拖窗口、按钮点不动。
            -->
            <Border Grid.Row="0" Height="48"
                    x:Name="TitleBar"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Border Width="60" IsVisible="{Binding IsMacOs}" />

                        <!--
                            软件图标放在软件名左边：和窗口图标、托盘图标同一个母版
                            （Assets/Icons 里那份 Corkboard.png 母图），只做展示，不标 User——按下跟着标题栏拖窗口。
                        -->
                        <Image Width="18"
                               Height="18"
                               VerticalAlignment="Center"
                               Source="/Assets/Icons/Corkboard.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                        <TextBlock Text="Corkboard"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        右上角：平时是「设置 + 排序 + 布置作业 + 时空回放」，进入回放后换成控制条。
                        回放控件也留在标题栏，用户不用在两个地方找入口。
                        点击穿透开着时整块隐藏：这些按钮一个都点不动，留着只会误导
                        （那种状态下主窗口完全不收鼠标，设置要从托盘菜单打开）。
                    -->
                    <StackPanel Grid.Column="2"
                                Classes="titlebar-actions"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !ViewModel.Config.Basic.ClickThrough}">
                        <!--
                            设置入口：主窗口是 WindowDecorations.None，没有系统按钮也没有菜单栏，
                            用户在窗口里能找到的设置入口就是这个齿轮（托盘菜单里也有一个）。
                            标题栏按下即拖，所以按钮必须标 User，否则按下会被判成拖窗口、点不动。
                        -->
                        <Button VerticalAlignment="Center"
                                IsVisible="{Binding ViewModel.ShowTitleBarSettings}"
                                ToolTip.Tip="{x:Static core:Resources.Menu_OpenSettings}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="OpenSettingsButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.SettingsFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button x:Name="SortButton"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ViewModel.ShowTitleBarSort}"
                                ToolTip.Tip="{Binding ViewModel.SortTip}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="SortButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.ArrowSortFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                            <!--
                                排序：原来在「设置 → 作业板」的下拉框里，现在放到标题栏这一排。
                                菜单是单选的，勾的就是当前档；选中即写配置（见 MainViewModel.SetSortMode），
                                作业板页面订阅了配置变化，会自己按新顺序重建。
                                按钮只给字形，当前档靠这里的提示与菜单里的勾表示。

                                菜单项不在这个可视树里（画在弹出层），所以既不绑 IsChecked 也不绑 Command：
                                勾选与点击都在代码隐藏里按配置收口（见 MainView.axaml.cs 的
                                RefreshSortMenuChecks / SortMenuItem_OnClick），与这一排其它按钮一样走 Click。
                            -->
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{x:Static core:Resources.Board_Sort_CreatedDescending}"
                                              ToggleType="Radio"
                                              GroupName="BoardSort"
                                              Tag="{x:Static enums:BoardSortMode.CreatedDescending}"
                                              Click="SortMenuItem_OnClick" />
                                    <MenuItem Header="{x:Static core:Resources.Board_Sort_CreatedAscending}"
                                              ToggleType="Radio"
                                              GroupName="BoardSort"
                                              Tag="{x:Static enums:BoardSortMode.CreatedAscending}"
                                              Click="SortMenuItem_OnClick" />
                                    <MenuItem Header="{x:Static core:Resources.Board_Sort_UpdatedDescending}"
                                              ToggleType="Radio"
                                              GroupName="BoardSort"
                                              Tag="{x:Static enums:BoardSortMode.UpdatedDescending}"
                                              Click="SortMenuItem_OnClick" />
                                    <MenuItem Header="{x:Static core:Resources.Board_Sort_Subject}"
                                              ToggleType="Radio"
                                              GroupName="BoardSort"
                                              Tag="{x:Static enums:BoardSortMode.Subject}"
                                              Click="SortMenuItem_OnClick" />
                                    <MenuItem Header="{x:Static core:Resources.Board_Sort_Manual}"
                                              ToggleType="Radio"
                                              GroupName="BoardSort"
                                              Tag="{x:Static enums:BoardSortMode.Manual}"
                                              Click="SortMenuItem_OnClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 要的是图标不是文字：与右下角那颗浮标同款加号，含义交给 ToolTip。 -->
                        <Button VerticalAlignment="Center"
                                ToolTip.Tip="{x:Static core:Resources.Board_AddNote}"
                                IsVisible="{Binding ViewModel.ShowTitleBarAssign}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="AddAssignmentButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.AddFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!--
                            导出：先弹格式对话框，图片直接保存、表格直接写成 xlsx。
                            按钮从作业板页面右上角搬到了标题栏（用户要求「保存按钮放到顶部去」），
                            真正的导出仍由页面自己做（它才知道板子内容容器在哪）。
                        -->
                        <Button VerticalAlignment="Center"
                                IsVisible="{Binding ViewModel.ShowTitleBarExport}"
                                ToolTip.Tip="{x:Static core:Resources.Export_DialogTitle}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="ExportImageButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.SaveFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!--
                            回放入口：要点两次才真的进去（第一次按钮变成高亮「已就绪」，同时提示语换成
                            「再点一次进入回放」，超时自动退回，见 BoardReplayService.Enter）。
                            一条作业都没有时整颗按钮不显示（CanEnterReplay）。
                            与这一排其它按钮一样只给图标，所以「已就绪」靠 accent 高亮 + ToolTip 表示。
                        -->
                        <Button VerticalAlignment="Center"
                                Classes.accent="{Binding Replay.IsArmed}"
                                IsVisible="{Binding ViewModel.ShowTitleBarReplay}"
                                ToolTip.Tip="{Binding Replay.EnterButtonText}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="ReplayEnterButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.HistoryFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!--
                            回放控制条：月历 + 「还原到此刻」+ 退出，进来就能挑任意一天往回看，
                            也可以直接把那一刻板上的作业整份放回当前板子。
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Replay.IsActive}">

                            <!--
                                回放时刻：原来是一个停靠点下拉框（一长串按秒排的时刻，滚都滚不完），
                                现在换成「按钮 + 月历浮层」——按钮上显示当前选中的那一刻，
                                点开按日期挑，挑完下面列出那天所有的时刻。
                                浮层内容挂在 Popup 里而不是 Button.Flyout：Popup 与按钮在同一个可视树里，
                                主题资源（深浅色）和 DataContext 都跟着走，这里也方便从代码里拿到内容。
                                ⚠️ 标题栏按下即拖，按钮必须标 ElementRole="User"，否则会被判成拖窗口、点不动。
                            -->
                            <Panel VerticalAlignment="Center">
                                <Button x:Name="ReplayCalendarButton"
                                        MinWidth="170"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{x:Static core:Resources.Board_ReplayCalendarTip}"
                                        WindowDecorationProperties.ElementRole="User"
                                        Click="ReplayCalendarButton_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!--
                                            日历字形：Assets/FluentSystemIcons-Resizable.json 里的
                                            ic_fluent_calendar_20_filled（U+E303）。图标常量在 Core，
                                            那边不让动，所以这里直接写码位。
                                        -->
                                        <TextBlock Text="&#xE303;"
                                                   FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Replay.SelectedStop.DisplayName}" />
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="ReplayCalendarPopup"
                                       PlacementTarget="{Binding #ReplayCalendarButton}"
                                       Placement="BottomEdgeAlignedRight"
                                       IsLightDismissEnabled="True">
                                    <views:ReplayCalendarView x:Name="ReplayCalendar" />
                                </Popup>
                            </Panel>

                            <Button VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static core:Resources.Board_ReplayRestoreTip}"
                                    WindowDecorationProperties.ElementRole="User"
                                    Click="ReplayRestoreButton_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Static icons:FluentIcons.ArrowCounterclockwiseFilled}"
                                               FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static core:Resources.Board_ReplayRestore}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button VerticalAlignment="Center"
                                    Classes="accent"
                                    ToolTip.Tip="{x:Static core:Resources.Board_ReplayExit}"
                                    WindowDecorationProperties.ElementRole="User"
                                    Click="ReplayExitButton_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Static icons:FluentIcons.ArrowExitFilled}"
                                               FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static core:Resources.Board_ReplayExit}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--
                            收纳：把主窗口收起来，屏幕上只留一颗展开按钮（位置 / 大小在
                            「设置 → 作业板 → 收纳」里调）。
                            它必须放在最右那颗「锁窗口」的左边：锁定后这一排整体隐藏，由独立的
                            ClickThroughLockWindow 在标题栏最右上角接着显示「开锁」，
                            那颗锁必须仍然是最右一个，两态位置才对得上、不会跳。
                            开关关掉时整颗不显示（DockEnabled）。
                        -->
                        <Button VerticalAlignment="Center"
                                IsVisible="{Binding ViewModel.ShowTitleBarDock}"
                                ToolTip.Tip="{x:Static core:Resources.Board_Dock_Collapse}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="DockButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.ArrowMinimizeFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!--
                            锁定窗口：按「设置 → 作业板 → 窗口与收纳 → 锁定按钮做什么」决定点下去
                            是开点击穿透还是只固定位置。它是这一排的最右一个，因为锁定后整排会隐藏、
                            由独立的 ClickThroughLockWindow 在同一位置接着显示「开锁」图标，
                            两态位置对齐才不会跳。
                            字形与提示跟着状态走（MainViewModel.LockWindowIcon / LockWindowTip）：
                            「固定位置」那一档锁上之后图标变闭锁、再点一次就解开，所以要能变。
                        -->
                        <Button VerticalAlignment="Center"
                                ToolTip.Tip="{Binding ViewModel.LockWindowTip}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="LockWindowButton_OnClick">
                            <TextBlock Text="{Binding ViewModel.LockWindowIcon}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                主界面没有侧边导航栏：默认主页面（AppConsts.DefaultMainPageId）直接铺满内容区，
                页面实例走键控 DI。主页面切换走 MainView.SelectNavigationItemById；
                设置界面是独立窗口（打开入口在托盘菜单）。
            -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <!--
                    页面标题紧贴自绘标题栏（也就是「Corkboard」那一行的正下方）：
                    原来留 16 的上边距，标题离软件名太远，看着像另一块内容。
                    标题本身的字号/行距由 TitleTextBlockStyle 决定，这里只收上边距。
                -->
                <TextBlock Grid.Row="0" Margin="12 4 18 0"
                           FontWeight="Normal"
                           IsVisible="{Binding !ViewModel.SelectedPageInfo.HidePageTitle}"
                           Text="{Binding ViewModel.PageTitle}"
                           Theme="{StaticResource TitleTextBlockStyle}" />

                <fa:FAFrame Grid.Row="1"
                            x:Name="NavigationFrame"
                            IsNavigationStackEnabled="False"
                            CacheSize="0" />
            </Grid>
        </Grid>

        <!--
            主窗口右下角的「布置作业」快捷按钮（开关在设置 → 基础设置）。
            它浮在页面内容之上、按窗口角定位，不跟着页面滚动；放在弹层遮罩之前，
            弹层打开时会被遮罩盖住，不会浮在表单上面。
            开着点击穿透时整窗都不收鼠标，这颗按钮照样点不动，所以那种状态下一起隐藏
            （与标题栏那一排同一个理由，见 MainViewModel.ShowCornerAssignButton）。
            回放期间也不显示：那时看的是历史快照，不接受新建。
        -->
        <Panel HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0 0 20 20"
               IsVisible="{Binding !Replay.IsActive}">
            <Button Width="56" Height="56"
                    Padding="0"
                    CornerRadius="16"
                    Classes="accent"
                    IsVisible="{Binding ViewModel.ShowCornerAssignButton}"
                    ToolTip.Tip="{x:Static core:Resources.Board_AddNote}"
                    WindowDecorationProperties.ElementRole="User"
                    Click="AddAssignmentButton_OnClick">
                <TextBlock Text="{x:Static icons:FluentIcons.AddFilled}"
                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                           FontSize="22"
                           VerticalAlignment="Center" />
            </Button>
        </Panel>

        <!--
            页面级弹层宿主。挂在壳的根 Panel 上而不是页面里，遮罩才能盖住上面的自绘标题栏。
            内容由 PageOverlayService 提供，页面只管 Show/Close。
        -->
        <Border Classes="scrim" IsVisible="{Binding Overlay.IsOpen}">
            <ContentControl Content="{Binding Overlay.Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
    </Panel>
</ContentPage>
