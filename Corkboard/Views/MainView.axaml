<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:enums="using:Corkboard.Core.Board"
             xmlns:views="using:Corkboard.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Corkboard.Views.MainView"
             x:DataType="views:MainView"
             Header="Corkboard"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Styles>
        <!--
            标题栏右上角的图标按钮：平时不画底，指上去才浮一层浅色，按下去再深一档。
            Fluent 的 Button 自带一层底色，六七个并排在一起就像一排贴片，把标题栏切得很碎；
            去掉底色之后一眼看过去只剩图标，主操作那颗实心强调色才显得突出。

            高度统一成 28：Fluent 的 Button 只给最小高度，实际高度是「内容高度 + 内边距」量出来的，
            只有图标的与图标+文字的两者量出来不一样，不统一就高矮不齐。

            用类名（titlebar-icon）而不是「StackPanel.titlebar-actions 的子孙」来选：后者会连带
            选中主操作那颗实心强调色按钮，两条样式同特异性、谁赢取决于来源顺序，hover 时底色会打架。
        -->
        <Style Selector="Button.titlebar-icon">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="6 0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!--
            底色是模板里那个 ContentPresenter 画的：只改 Button.Background 管不到指针态
            （模板在 :pointerover 里直接给 ContentPresenter 设了底色）。
        -->
        <Style Selector="Button.titlebar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.titlebar-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>

        <!--
            主操作「布置作业」：整排里唯一的实心强调色，带图标 + 文字，把最常按的那一颗挑出来。
            不叠 FluentAvalonia 的 accent 类：那套选择器与上面那条同特异性、顺序敏感，
            这里自己写全套三态，稳定。
        -->
        <Style Selector="Button.main-action">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="Margin" Value="4 0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.main-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.main-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <!--
            锁定开关。要让 ToggleSwitch 缩成一颗小开关，得把自带的那段「开 / 关」文字去掉
            （XAML 里 OnContent / OffContent 都写 null），并把默认的宽下限解开——
            Fluent 那个 MinWidth 是按带文字排的，留着会在标题栏里空出一大块。
            ⚠️ 宽度要写 40：默认量出来是 52，右边多出的 12 是给「开 / 关」文字留的位置，
            内容写 null 之后那块空着，看起来就像开关离窗口右边多缩了一截。

            ⚠️ 高度写 28 是「和旁边那几颗按钮同高」，但它**必须跟下面那颗开关上的
            ToggleSwitch.Resources 一起改**，单改这一条会更歪：
            FluentAvalonia 3.0.2 的 ToggleSwitch 模板（Grid RowDefinitions="Auto,*"）里，
            第 0 行是给页头留的 ContentPresenter、带 `ToggleSwitchTopHeaderMargin` = 0,0,0,4，
            **Content 为 null 也照占这 4 DIP**；第 1 行是「上 10 / 轨道 20 / 下 10」。
            所以轨道在控件自身坐标里恒在 y = 4+10 = 14..34（跟 Height 无关，Height 只决定裁掉多少）：
              · 不写 Height（盒子 32 高）→ 轨道中心 24、盒中心 16，**轨道比按钮低 8 DIP**
                （用户看到的就是这个），而且轨道底部探出盒子 2 DIP 被 ClipToBounds 切平；
              · 只写 Height=28 → 盒中心 14、轨道中心 24，偏 10 DIP，切得更狠；
              · 现在这套（Height=28 + 页头 0 / 上 4 / 下 4）→ 盒 28 高、轨道 4..24、
                中心 14 = 盒中心，与 28 高的按钮盒完全重合，也不再越界被裁。
            资源键是库的模板内部键（版本在 Directory.Build.props 钉死）；万一以后库把键改名，
            表现是「退回 44 的自然布局、开关又偏下去」，不是崩溃。
        -->
        <Style Selector="ToggleSwitch.titlebar-switch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8 0 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentPage.Styles>
    <Panel>
        <Grid RowDefinitions="Auto *">
            <!--
                自定义标题栏：拖动区域与交互元素必须显式声明 ElementRole。
                标题栏按下即拖（见 MainView.OnPointerPressedForDrag），所以里面的按钮一律标 User，
                否则按下会被判成拖窗口、按钮点不动。
            -->
            <Border Grid.Row="0" Height="48"
                    x:Name="TitleBar"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Border Width="60" IsVisible="{Binding IsMacOs}" />

                        <!--
                            软件图标放在软件名左边：和窗口图标、托盘图标同一个母版
                            （Assets/Icons 里那份 Corkboard.png 母图），只做展示，不标 User——按下跟着标题栏拖窗口。
                        -->
                        <Image Width="18"
                               Height="18"
                               VerticalAlignment="Center"
                               Source="/Assets/Icons/Corkboard.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                        <TextBlock Text="Corkboard"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        右上角只有五样：设置 / 看板模式 / 布置作业（唯一的实心强调色）/ 更多 / 锁定开关。
                        排序、导出、时空回放、收纳都收进了「更多」菜单——它们是「偶尔点一次」的动作，
                        平铺在一排里既挤又容易误点。进入回放后中间换成控制条。
                        整排始终在：解锁态下「布置作业」与「更多」里那几件动板子的事各自收起
                        （见 MainViewModel 那几个 ShowTitleBar*），设置、看板模式与锁仍然可点。
                    -->
                    <StackPanel Grid.Column="2"
                                Classes="titlebar-actions"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <!--
                            设置入口：主窗口是 WindowDecorations.None，没有系统按钮也没有菜单栏，
                            用户在窗口里能找到的设置入口就是这个齿轮（托盘菜单里也有一个）。
                            标题栏按下即拖，所以按钮必须标 User，否则按下会被判成拖窗口、点不动。
                        -->
                        <Button Classes="titlebar-icon"
                                IsVisible="{Binding ViewModel.ShowTitleBarSettings}"
                                ToolTip.Tip="{x:Static core:Resources.Menu_OpenSettings}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="OpenSettingsButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.SettingsFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!--
                            看板模式：点一下直接铺全屏（与托盘菜单、「更多」里的入口同一个动作）。
                            面板就这么一块屏，展示时不该为了进全屏再去开设置窗口找按钮。
                            默认显示，可以在「设置 → 作业板 → 界面入口 → 顶部按钮」里关掉。
                        -->
                        <Button Classes="titlebar-icon"
                                IsVisible="{Binding ViewModel.ShowTitleBarDisplay}"
                                ToolTip.Tip="{x:Static core:Resources.Menu_OpenDisplayBoard}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="OpenDisplayModeButton_OnClick">
                            <TextBlock Text="{x:Static icons:FluentIcons.FullScreenMaximizeFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!--
                            主操作：整排里唯一的实心强调色。图标 + 文字，与右下角那颗浮标同一个入口，
                            点下去开布置作业表单。
                        -->
                        <Button Classes="main-action"
                                IsVisible="{Binding ViewModel.ShowTitleBarAssign}"
                                ToolTip.Tip="{x:Static core:Resources.Board_AddNote}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="AddAssignmentButton_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Static icons:FluentIcons.AddFilled}"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static core:Resources.Board_AddNote}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!--
                            更多：排序 / 导出 / 时空回放 / 收纳四件事都收进这个菜单。
                            它们都是「偶尔点一次」的动作，平铺在标题栏里既挤又容易误点，
                            收进菜单之后标题栏只剩设置、布置作业、更多与锁定四样。
                            四个开关全关掉时整颗按钮也不显示（ShowTitleBarMore）。

                            菜单项不在这个可视树里（画在弹出层），所以既不绑 IsVisible 也不绑 IsChecked、
                            不绑 Command：显隐与勾选都在弹出那一刻由代码按配置写，
                            点击一律走 Click（见 MainView.axaml.cs 的 RefreshMoreMenu / SortMenuItem_OnClick）。
                        -->
                        <Button x:Name="MoreButton"
                                Classes="titlebar-icon"
                                IsVisible="{Binding ViewModel.ShowTitleBarMore}"
                                ToolTip.Tip="{x:Static core:Resources.MainView_More}"
                                WindowDecorationProperties.ElementRole="User"
                                Click="MoreButton_OnClick">
                            <!-- 三点：Assets/FluentSystemIcons-Resizable.json 里的
                                 ic_fluent_more_horizontal_20_filled（U+EBAB）。图标常量在 Core，那边不让动，
                                 所以这里直接写码位（与下面日历字形同一个做法）。 -->
                            <TextBlock Text="&#xEBAB;"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       VerticalAlignment="Center" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <!-- 排序是子菜单：单选，勾的就是当前档。 -->
                                    <MenuItem Classes="more-sort" Header="{x:Static core:Resources.Board_Sort_Title}">
                                        <MenuItem Header="{x:Static core:Resources.Board_Sort_CreatedDescending}"
                                                  ToggleType="Radio"
                                                  GroupName="BoardSort"
                                                  Tag="{x:Static enums:BoardSortMode.CreatedDescending}"
                                                  Click="SortMenuItem_OnClick" />
                                        <MenuItem Header="{x:Static core:Resources.Board_Sort_CreatedAscending}"
                                                  ToggleType="Radio"
                                                  GroupName="BoardSort"
                                                  Tag="{x:Static enums:BoardSortMode.CreatedAscending}"
                                                  Click="SortMenuItem_OnClick" />
                                        <MenuItem Header="{x:Static core:Resources.Board_Sort_UpdatedDescending}"
                                                  ToggleType="Radio"
                                                  GroupName="BoardSort"
                                                  Tag="{x:Static enums:BoardSortMode.UpdatedDescending}"
                                                  Click="SortMenuItem_OnClick" />
                                        <MenuItem Header="{x:Static core:Resources.Board_Sort_Subject}"
                                                  ToggleType="Radio"
                                                  GroupName="BoardSort"
                                                  Tag="{x:Static enums:BoardSortMode.Subject}"
                                                  Click="SortMenuItem_OnClick" />
                                        <MenuItem Header="{x:Static core:Resources.Board_Sort_Manual}"
                                                  ToggleType="Radio"
                                                  GroupName="BoardSort"
                                                  Tag="{x:Static enums:BoardSortMode.Manual}"
                                                  Click="SortMenuItem_OnClick" />
                                    </MenuItem>
                                    <!--
                                        导出：先弹格式对话框，图片直接保存、表格直接写成 xlsx。
                                        真正的导出仍由页面自己做（它才知道板子内容容器在哪）。
                                    -->
                                    <MenuItem Classes="more-export"
                                              Header="{x:Static core:Resources.Export_DialogTitle}"
                                              Click="ExportImageButton_OnClick" />
                                    <!--
                                        回放入口：第一次点只是「就绪」，再点一次才真的进去，超时自动退回
                                        （见 BoardReplayService.Enter）。一条作业都没有时这一项不显示。
                                    -->
                                    <MenuItem Classes="more-replay"
                                              Header="{x:Static core:Resources.Board_Replay}"
                                              Click="ReplayEnterButton_OnClick" />
                                    <!-- 收纳：把作业板收起来，屏幕上只留一颗展开按钮。 -->
                                    <MenuItem Classes="more-dock"
                                              Header="{x:Static core:Resources.Board_Dock_Collapse}"
                                              Click="DockButton_OnClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!--
                            回放控制条：月历 + 「还原到此刻」+ 退出，进来就能挑任意一天往回看，
                            也可以直接把那一刻板上的作业整份放回当前板子。
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Replay.IsActive}">

                            <!--
                                回放时刻：原来是一个停靠点下拉框（一长串按秒排的时刻，滚都滚不完），
                                现在换成「按钮 + 月历浮层」——按钮上显示当前选中的那一刻，
                                点开按日期挑，挑完下面列出那天所有的时刻。
                                浮层内容挂在 Popup 里而不是 Button.Flyout：Popup 与按钮在同一个可视树里，
                                主题资源（深浅色）和 DataContext 都跟着走，这里也方便从代码里拿到内容。
                                ⚠️ 标题栏按下即拖，按钮必须标 ElementRole="User"，否则会被判成拖窗口、点不动。
                            -->
                            <Panel VerticalAlignment="Center">
                                <Button x:Name="ReplayCalendarButton"
                                        Classes="titlebar-icon"
                                        MinWidth="170"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{x:Static core:Resources.Board_ReplayCalendarTip}"
                                        WindowDecorationProperties.ElementRole="User"
                                        Click="ReplayCalendarButton_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!--
                                            日历字形：Assets/FluentSystemIcons-Resizable.json 里的
                                            ic_fluent_calendar_20_filled（U+E303）。图标常量在 Core，
                                            那边不让动，所以这里直接写码位。
                                        -->
                                        <TextBlock Text="&#xE303;"
                                                   FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Replay.SelectedStop.DisplayName}" />
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="ReplayCalendarPopup"
                                       PlacementTarget="{Binding #ReplayCalendarButton}"
                                       Placement="BottomEdgeAlignedRight"
                                       IsLightDismissEnabled="True">
                                    <views:ReplayCalendarView x:Name="ReplayCalendar" />
                                </Popup>
                            </Panel>

                            <Button Classes="titlebar-icon"
                                    ToolTip.Tip="{x:Static core:Resources.Board_ReplayRestoreTip}"
                                    WindowDecorationProperties.ElementRole="User"
                                    Click="ReplayRestoreButton_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Static icons:FluentIcons.ArrowCounterclockwiseFilled}"
                                               FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static core:Resources.Board_ReplayRestore}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="main-action"
                                    ToolTip.Tip="{x:Static core:Resources.Board_ReplayExit}"
                                    WindowDecorationProperties.ElementRole="User"
                                    Click="ReplayExitButton_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Static icons:FluentIcons.ArrowExitFilled}"
                                               FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static core:Resources.Board_ReplayExit}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--
                            锁定：拨上去 = 窗口位置与大小都钉住、板子照常查看与编辑；
                            拨下来 = 解锁（调整窗口）态，能拖标题栏、能拉四边，但内容区会盖一层遮罩，
                            遮罩期间不能编辑作业。
                            提示文案跟着状态走（MainViewModel.LockWindowTip）：锁着时说解锁、没锁时说锁定。
                            ⚠️ ToggleSwitch 不是 Button 的子类，光标 ElementRole 还不够——
                            它必须同时列进 MainView.IsInteractiveSource，否则标题栏会把按下当成拖窗口。
                        -->
                        <ToggleSwitch Classes="titlebar-switch"
                                      OnContent="{x:Null}"
                                      OffContent="{x:Null}"
                                      IsChecked="{Binding ViewModel.IsWindowLocked, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding ViewModel.LockWindowTip}"
                                      WindowDecorationProperties.ElementRole="User">
                            <!--
                                把模板里的「页头 4 / 上 10 / 下 10」换成「0 / 4 / 4」，轨道就是
                                28 高盒子正中的 20（4..24），与旁边那几颗 28 高的按钮垂直对齐
                                （几何与依据见上面 ToggleSwitch.titlebar-switch 那段注释）。
                                写在**这一颗开关自己**的 Resources 里，不要提到页面级——
                                那样 MainView 子树里其它 ToggleSwitch 的内边距会一起被改掉。
                            -->
                            <ToggleSwitch.Resources>
                                <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
                                <GridLength x:Key="ToggleSwitchPreContentMargin">4</GridLength>
                                <GridLength x:Key="ToggleSwitchPostContentMargin">4</GridLength>
                            </ToggleSwitch.Resources>
                        </ToggleSwitch>
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                主界面没有侧边导航栏：默认主页面（AppConsts.DefaultMainPageId）直接铺满内容区，
                页面实例走键控 DI。主页面切换走 MainView.SelectNavigationItemById；
                设置界面是独立窗口（打开入口在托盘菜单）。
            -->
            <Grid Grid.Row="1" RowDefinitions="Auto, *">
                <!--
                    页面标题紧贴自绘标题栏（也就是「Corkboard」那一行的正下方）：
                    原来留 16 的上边距，标题离软件名太远，看着像另一块内容。
                    标题本身的字号/行距由 TitleTextBlockStyle 决定，这里只收上边距。
                -->
                <TextBlock Grid.Row="0" Margin="12 4 18 0"
                           FontWeight="Normal"
                           IsVisible="{Binding !ViewModel.SelectedPageInfo.HidePageTitle}"
                           Text="{Binding ViewModel.PageTitle}"
                           Theme="{StaticResource TitleTextBlockStyle}" />

                <fa:FAFrame Grid.Row="1"
                            x:Name="NavigationFrame"
                            IsNavigationStackEnabled="False"
                            CacheSize="0" />

                <!--
                    解锁态（调整窗口态）的遮罩：只盖内容区，页面标题那一行也算在内——
                    拿掉指针就等于不能编辑作业、也不能布置作业。自绘标题栏不在这个 Grid 里，
                    所以解锁时照样能拖标题栏挪窗口、照样能点那颗锁把窗口锁回去。
                    它不是模态弹层：上面那张卡只是说明 + 一颗「锁定」按钮，压在页面弹层遮罩之下。
                -->
                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Classes="lock-mask"
                        IsVisible="{Binding ViewModel.IsWindowAdjusting}">
                    <Border Classes="lock-mask-card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Static icons:FluentIcons.LockOpenFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static core:Resources.Board_UnlockMaskTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Static core:Resources.Board_UnlockMaskDescription}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static core:Resources.Board_UnlockMaskHint}"
                                       Margin="0 2 0 4"
                                       FontSize="12"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Classes="accent"
                                    Content="{x:Static core:Resources.Board_UnlockMaskLock}"
                                    HorizontalAlignment="Center"
                                    Click="LockMaskButton_OnClick" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!--
            主窗口右下角的「布置作业」快捷按钮（开关在设置 → 作业板 → 常规）。
            它浮在页面内容之上、按窗口角定位，不跟着页面滚动；放在弹层遮罩之前，
            弹层打开时会被遮罩盖住，不会浮在表单上面。
            解锁态（遮罩盖着内容区、不能编辑作业）里也一起隐藏：与标题栏那颗「布置作业」
            同一个理由，见 MainViewModel.ShowCornerAssignButton。
            回放期间也不显示：那时看的是历史快照，不接受新建。
        -->
        <Panel HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0 0 20 20"
               IsVisible="{Binding !Replay.IsActive}">
            <Button Width="56" Height="56"
                    Padding="0"
                    CornerRadius="16"
                    Classes="accent"
                    IsVisible="{Binding ViewModel.ShowCornerAssignButton}"
                    ToolTip.Tip="{x:Static core:Resources.Board_AddNote}"
                    WindowDecorationProperties.ElementRole="User"
                    Click="AddAssignmentButton_OnClick">
                <TextBlock Text="{x:Static icons:FluentIcons.AddFilled}"
                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                           FontSize="22"
                           VerticalAlignment="Center" />
            </Button>
        </Panel>

        <!--
            页面级弹层宿主。挂在壳的根 Panel 上而不是页面里，遮罩才能盖住上面的自绘标题栏。
            内容由 PageOverlayService 提供，页面只管 Show/Close。
            ⚠️ 绑的是 OverlayHost（壳自己那份）而不是 Overlay：宿主可以有多个，
            全屏展示窗口层级更高时由它来画，壳这边要干干净净。
        -->
        <Border Classes="scrim" IsVisible="{Binding OverlayHost.IsOpen}">
            <ContentControl Content="{Binding OverlayHost.Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
    </Panel>
</ContentPage>
