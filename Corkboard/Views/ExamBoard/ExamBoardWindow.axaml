<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Corkboard.ViewModels.ExamBoard"
        xmlns:local="using:Corkboard.Views.ExamBoard"
        xmlns:core="using:Corkboard.Core.Langs.Common"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="Corkboard.Views.ExamBoard.ExamBoardWindow"
        x:DataType="vm:ExamBoardViewModel"
        Title="{x:Static core:Resources.Exam_Board_DefaultTitle}"
        WindowDecorations="None"
        WindowState="FullScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource ExamBoardSurfaceBrush}">
    <!-- 全屏考试看板；版式在共享的 ExamBoardView 里（布局编辑窗宿主同一份视图）。 -->
    <local:ExamBoardView />
</Window>