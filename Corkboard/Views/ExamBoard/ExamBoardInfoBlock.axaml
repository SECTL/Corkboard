<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Corkboard.ViewModels.ExamBoard"
             x:Class="Corkboard.Views.ExamBoard.ExamBoardInfoBlock"
             x:DataType="vm:ExamBoardViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.remaining">
            <Setter Property="Foreground" Value="{DynamicResource ExamBoardTextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.remaining.urgent">
            <Setter Property="Foreground" Value="{DynamicResource ExamBoardUrgentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- 时钟下面那组考试信息：始终独立一块（表格收起时是屏幕上唯一的信息）。 -->
    <StackPanel IsVisible="{Binding ShowExamInfo}"
                HorizontalAlignment="Center"
                Spacing="6"
                Margin="0,30,0,0">
        <Border Width="240"
                Height="1"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Opacity="0.45"
                Background="{DynamicResource ExamBoardDividerBrush}" />
        <TextBlock Text="{Binding InfoCaption}"
                   FontSize="{Binding InfoCaptionFontSize}"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource ExamBoardTextTertiaryBrush}" />
        <TextBlock Text="{Binding InfoSubject}"
                   FontSize="{Binding InfoSubjectFontSize}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ExamBoardTextPrimaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
            <TextBlock Text="{Binding InfoDateText}"
                       FontSize="{Binding InfoTimeFontSize}"
                       Foreground="{DynamicResource ExamBoardTextSecondaryBrush}" />
            <TextBlock Text="{Binding InfoTimeRange}"
                       FontSize="{Binding InfoTimeFontSize}"
                       FontFeatures="{Binding NumericFontFeatures}"
                       Foreground="{DynamicResource ExamBoardTextSecondaryBrush}" />
        </StackPanel>
        <TextBlock Classes="remaining"
                   Classes.urgent="{Binding InfoIsUrgent}"
                   Text="{Binding InfoRemaining}"
                   IsVisible="{Binding InfoHasRemaining}"
                   FontSize="{Binding InfoRemainingFontSize}"
                   FontFeatures="{Binding NumericFontFeatures}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding InfoPaperInfo}"
                   IsVisible="{Binding InfoHasPaperInfo}"
                   FontSize="{Binding InfoPaperFontSize}"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource ExamBoardTextTertiaryBrush}" />
    </StackPanel>
</UserControl>