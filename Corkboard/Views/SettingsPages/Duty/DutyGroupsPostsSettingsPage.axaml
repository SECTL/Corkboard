<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Duty"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Corkboard.Views.SettingsPages.Duty.DutyGroupsPostsSettingsPage"
             x:DataType="vm:DutyGroupsPostsSettingsPageViewModel">
    <!--
        「小组与职务」：页标题 → 命令栏 → 状态行 → 三张 DataGrid（小组 / 职务 / 固定人员），
        成员与分工这类需要勾选的表单继续用设置卡分段。
        顺序字段用上移/下移维护（Order 落盘，轮流模式按它排队）；表单都开右侧抽屉。
        文案先硬编码中文，TODO 资源键：Settings_Duty_Groups_*。
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Classes="page-container">
        <TextBlock Grid.Row="0"
                   Margin="0 4 0 0"
                   FontWeight="Normal"
                   Text="{x:Static core:Resources.Settings_Duty_Groups_Title}"
                   Theme="{StaticResource TitleTextBlockStyle}" />

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <fa:FACommandBar DefaultLabelPosition="Right">
                <fa:FACommandBar.PrimaryCommands>
                    <fa:FACommandBarButton Label="刷新" Click="OnRefreshClick">
                        <fa:FACommandBarButton.IconSource>
                            <fa:FAFontIconSource Glyph="{x:Static icons:FluentIcons.ArrowClockwiseFilled}" />
                        </fa:FACommandBarButton.IconSource>
                    </fa:FACommandBarButton>

                    <fa:FACommandBarSeparator />

                    <fa:FACommandBarButton Label="新增小组" Click="OnAddGroupClick">
                        <fa:FACommandBarButton.IconSource>
                            <fa:FAFontIconSource Glyph="{x:Static icons:FluentIcons.AddFilled}" />
                        </fa:FACommandBarButton.IconSource>
                    </fa:FACommandBarButton>

                    <fa:FACommandBarButton Label="新增职务" Click="OnAddPostClick">
                        <fa:FACommandBarButton.IconSource>
                            <fa:FAFontIconSource Glyph="{x:Static icons:FluentIcons.AddFilled}" />
                        </fa:FACommandBarButton.IconSource>
                    </fa:FACommandBarButton>

                    <fa:FACommandBarButton Label="添加固定人员" Click="OnAddFixedClick">
                        <fa:FACommandBarButton.IconSource>
                            <fa:FAFontIconSource Glyph="{x:Static icons:FluentIcons.PeopleFilled}" />
                        </fa:FACommandBarButton.IconSource>
                    </fa:FACommandBarButton>
                </fa:FACommandBar.PrimaryCommands>
            </fa:FACommandBar>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SummaryText}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <!-- ① 小组表 -->
                <TextBlock Classes="section-title" Text="小组" />
                <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="4">
                    <DataGrid Height="200"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="64" Header="顺序" Binding="{Binding OrderText}" />
                            <DataGridTextColumn Width="1.2*" MinWidth="120" Header="小组名" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="1.6*" MinWidth="160" Header="成员" Binding="{Binding MemberSummary}" />
                            <DataGridTextColumn Width="80" Header="人数" Binding="{Binding MemberCount}" />

                            <DataGridTemplateColumn Width="230" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DutyGroupRow">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnGroupUpClick"
                                                    Content="上移"
                                                    ToolTip.Tip="在小组顺序里往上挪一位" />
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnGroupDownClick"
                                                    Content="下移"
                                                    ToolTip.Tip="在小组顺序里往下挪一位" />
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnGroupRenameClick"
                                                    Content="改名" />
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnGroupDeleteClick"
                                                    Content="删除"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ② 组内成员：先选小组，再勾出这个组的人 -->
                <fa:FASettingsExpander Header="组内成员" Description="先选小组，再勾出这个组的人">
                    <StackPanel Spacing="10">
                        <ComboBox ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                  PlaceholderText="选择小组">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DutyGroupRow">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ItemsControl ItemsSource="{Binding GroupMemberToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DutyMemberToggle">
                                    <CheckBox Margin="0 0 16 4"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding SaveGroupMembersCommand}" Content="保存这个组的成员" />
                    </StackPanel>
                </fa:FASettingsExpander>

                <!-- ③ 职务表 -->
                <TextBlock Classes="section-title" Text="职务" />
                <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="4">
                    <DataGrid Height="200"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              ItemsSource="{Binding Posts}"
                              SelectedItem="{Binding SelectedPost, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="64" Header="顺序" Binding="{Binding OrderText}" />
                            <DataGridTextColumn Width="*" MinWidth="120" Header="职务名" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="100" Header="默认人数" Binding="{Binding DefaultMemberCount}" />

                            <DataGridTemplateColumn Width="230" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DutyPostRow">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnPostUpClick"
                                                    Content="上移"
                                                    ToolTip.Tip="在职务顺序里往上挪一位" />
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnPostDownClick"
                                                    Content="下移"
                                                    ToolTip.Tip="在职务顺序里往下挪一位" />
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnPostEditClick"
                                                    Content="编辑" />
                                            <Button Padding="8 2" MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnPostDeleteClick"
                                                    Content="删除"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ④ 组内分工：这个职务在本组由谁干 -->
                <fa:FASettingsExpander Header="组内分工" Description="不配就按组内名单顺序自动补人；配了以这里为准">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,240,Auto">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Groups}"
                                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                      PlaceholderText="选择小组">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DutyGroupRow">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="1"
                                      Margin="8 0 0 0"
                                      ItemsSource="{Binding Posts}"
                                      SelectedItem="{Binding SelectedPositionPost, Mode=TwoWay}"
                                      PlaceholderText="选择职务">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DutyPostRow">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Margin="8 0 0 0"
                                    Command="{Binding SavePositionAssignmentsCommand}"
                                    Content="保存分工" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PositionToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DutyMemberToggle">
                                    <CheckBox Margin="0 0 16 4"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding ClearPositionAssignmentsCommand}" Content="清空这个组的全部职务分配" />
                    </StackPanel>
                </fa:FASettingsExpander>

                <!-- ⑤ 固定人员表 -->
                <TextBlock Classes="section-title" Text="固定人员" />
                <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="4">
                    <DataGrid Height="200"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              ItemsSource="{Binding FixedAssignments}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="1*" MinWidth="110" Header="职务" Binding="{Binding PostName}" />
                            <DataGridTextColumn Width="1*" MinWidth="110" Header="人员" Binding="{Binding MemberName}" />
                            <DataGridTextColumn Width="1.4*" MinWidth="140" Header="星期" Binding="{Binding WeekdaysText}" />
                            <DataGridTextColumn Width="90" Header="关系" Binding="{Binding RelationText}" />
                            <DataGridTextColumn Width="150" Header="生效区间" Binding="{Binding RangeText}" />

                            <DataGridTemplateColumn Width="100" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DutyFixedAssignmentRow">
                                        <Button Padding="8 2" MinWidth="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnFixedDeleteClick"
                                                Content="删除"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           IsVisible="{Binding !HasFixedAssignments}"
                           Text="还没有固定人员：用上面的「添加固定人员」给某职务指定固定的人"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
