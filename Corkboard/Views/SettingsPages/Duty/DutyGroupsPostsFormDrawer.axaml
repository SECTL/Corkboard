<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Duty"
             x:Class="Corkboard.Views.SettingsPages.Duty.DutyGroupsPostsFormDrawer"
             x:DataType="vm:DutyGroupsPostsSettingsPageViewModel"
             Width="360">
    <!--
        「小组与职务」页的右侧抽屉：新增/重命名小组、新增/编辑职务、添加固定人员三套表单共用，
        由 ViewModel 的 EditorMode 切换显示哪一段。
        文案先硬编码中文，TODO 资源键：Settings_Duty_Groups_Editor_*。
    -->
    <Grid Margin="16" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding EditorTitle}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding EditorSubtitle}"
                           TextWrapping="Wrap" />

                <!-- 小组表单 -->
                <StackPanel IsVisible="{Binding IsGroupEditor}" Spacing="4">
                    <TextBlock Classes="caption" Text="小组名" />
                    <TextBox PlaceholderText="例如 一组 / 第二组" Text="{Binding EditorName, Mode=TwoWay}" />
                </StackPanel>

                <!-- 职务表单 -->
                <StackPanel IsVisible="{Binding IsPostEditor}" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="职务名" />
                        <TextBox PlaceholderText="例如 擦柜子 / 扫地" Text="{Binding EditorName, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="默认人数" />
                        <NumericUpDown HorizontalAlignment="Stretch"
                                       Maximum="20"
                                       Minimum="1"
                                       Value="{Binding EditorCount, Mode=TwoWay}" />
                        <TextBlock Classes="caption"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="组里没手工分配时，按这个人数从名单顺序里自动补人"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- 固定人员表单 -->
                <StackPanel IsVisible="{Binding IsFixedEditor}" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="职务" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Posts}"
                                  PlaceholderText="选择职务"
                                  SelectedItem="{Binding SelectedPost, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DutyPostRow">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="人员" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Members}"
                                  PlaceholderText="选择人员（可以跨组）"
                                  SelectedItem="{Binding FixedMember, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DutyMemberToggle">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="关系" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Relations}"
                                  SelectedItem="{Binding SelectedRelation, Mode=TwoWay}" />
                        <TextBlock Classes="caption"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="替换：这一天本来排到别人时改由他做；叠加：他额外多做一份"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="固定做这个职务的星期" />
                        <ItemsControl ItemsSource="{Binding WeekdayToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DutyWeekdayToggle">
                                    <CheckBox Margin="0 0 12 4"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0 12 0 0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Click="OnCancelClick" Content="取消" />
            <Button Classes="accent" Click="OnSaveClick" Content="{Binding EditorPrimaryText}" />
        </StackPanel>
    </Grid>
</UserControl>
