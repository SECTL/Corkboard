<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:icons="clr-namespace:Corkboard.Core.Icons;assembly=Corkboard.Core"
             xmlns:vm="clr-namespace:Corkboard.ViewModels.SettingsPages.Duty"
             x:Class="Corkboard.Views.SettingsPages.Duty.DutyMembersSettingsPage"
             x:DataType="vm:DutyMembersSettingsPageViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Classes="page-container">
        <TextBlock Grid.Row="0"
                   Text="名单与导入"
                   FontWeight="Normal"
                   Margin="0 4 0 0"
                   Theme="{StaticResource TitleTextBlockStyle}" />

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4,2">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <fa:FACommandBar Grid.Column="0" DefaultLabelPosition="Right">
                    <fa:FACommandBar.PrimaryCommands>
                        <fa:FACommandBarButton Label="{Binding CurrentRosterLabel}"
                                               ToolTip.Tip="当前名单与来源"
                                               Click="OnShowRosterClick">
                            <fa:FACommandBarButton.IconSource>
                                <!-- people_list_20_filled -->
                                <fa:FAFontIconSource Glyph="&#xECC4;"
                                                     FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                            </fa:FACommandBarButton.IconSource>
                        </fa:FACommandBarButton>

                        <fa:FACommandBarButton Label="刷新" Click="OnRefreshClick">
                            <fa:FACommandBarButton.IconSource>
                                <fa:FAFontIconSource Glyph="{x:Static icons:FluentIcons.ArrowClockwiseFilled}"
                                                     FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                            </fa:FACommandBarButton.IconSource>
                        </fa:FACommandBarButton>

                        <fa:FACommandBarSeparator />

                        <fa:FACommandBarButton Label="添加成员" Click="OnAddMemberClick">
                            <fa:FACommandBarButton.IconSource>
                                <!-- person_add_20_filled -->
                                <fa:FAFontIconSource Glyph="&#xECEC;"
                                                     FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                            </fa:FACommandBarButton.IconSource>
                        </fa:FACommandBarButton>

                        <fa:FACommandBarButton Label="导入名单" Click="OnImportClick">
                            <fa:FACommandBarButton.IconSource>
                                <!-- people_add_20_filled -->
                                <fa:FAFontIconSource Glyph="&#xECAC;"
                                                     FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                            </fa:FACommandBarButton.IconSource>
                        </fa:FACommandBarButton>

                        <fa:FACommandBarButton Label="导出名单" Click="OnExportClick">
                            <fa:FACommandBarButton.IconSource>
                                <!-- arrow_download_20_filled -->
                                <fa:FAFontIconSource Glyph="&#xE0D2;"
                                                     FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                            </fa:FACommandBarButton.IconSource>
                        </fa:FACommandBarButton>
                    </fa:FACommandBar.PrimaryCommands>
                </fa:FACommandBar>

                <TextBox Grid.Column="2"
                         Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="搜索姓名、序号或小组" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatsText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Panel Grid.Row="3">
            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4 4 0 0"
                    ClipToBounds="True">
                <DataGrid MinHeight="320"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          IsReadOnly="False"
                          CellEditEnded="OnCellEditEnded"
                          ItemsSource="{Binding Members}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="64" MinWidth="64" Header="编辑" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMemberItem">
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="编辑成员"
                                            CommandParameter="{Binding}"
                                            Click="OnEditClick">
                                        <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                   Text="{x:Static icons:FluentIcons.EditFilled}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridCheckBoxColumn MinWidth="64"
                                                Header="参加值日"
                                                Binding="{Binding IsActive, Mode=TwoWay}" />

                        <DataGridTextColumn Width="0.8*" MinWidth="80"
                                            Header="序号"
                                            IsReadOnly="False"
                                            Binding="{Binding Id, Mode=TwoWay}" />

                        <DataGridTextColumn Width="1.5*" MinWidth="150"
                                            Header="姓名"
                                            IsReadOnly="False"
                                            Binding="{Binding Name, Mode=TwoWay}" />

                        <DataGridTextColumn Width="1*" MinWidth="100"
                                            Header="性别"
                                            IsReadOnly="False"
                                            Binding="{Binding Gender, Mode=TwoWay}" />

                        <DataGridTemplateColumn Width="1*" MinWidth="100" Header="小组" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMemberItem">
                                    <ComboBox HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="2,0"
                                              ItemsSource="{Binding GroupOptions}"
                                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DutyMemberGroupOption">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="1.2*" MinWidth="120"
                                            Header="标签"
                                            IsReadOnly="False"
                                            Binding="{Binding Tags, Mode=TwoWay}" />

                        <DataGridTemplateColumn Width="64" MinWidth="64" Header="操作" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DutyMemberItem">
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Theme="{StaticResource TransparentButton}"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            ToolTip.Tip="从名单里删除成员"
                                            CommandParameter="{Binding}"
                                            Click="OnDeleteClick">
                                        <TextBlock FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                   Text="{x:Static icons:FluentIcons.DeleteFilled}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border IsVisible="{Binding ShowEmptyState}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24,20"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding EmptyStateText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </Panel>
    </Grid>
</UserControl>