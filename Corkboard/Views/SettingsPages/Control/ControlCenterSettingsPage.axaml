<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Control"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:icons="using:Corkboard.Core.Icons"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Corkboard.Views.SettingsPages.ControlCenter.ControlCenterSettingsPage"
             x:DataType="vm:ControlCenterSettingsPageViewModel">
    <ScrollViewer>
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Control_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!--
                四张卡（同时可见三张）：连接（开关 + 状态 + 自动备份）、设备（名字 / ID / 网页控制台）、
                接入集控（未接入才显示）、清空接入（已接入才显示）。
                卡里按行放 FASettingsExpanderItem——名称与简介在左、控件在右。
                注意**不能卡套卡**：外层展开时内层会抛 NullReferenceException。
            -->

            <!-- ============================== 连接 ============================== -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_SectionConnection}"
                                   IsExpanded="True">
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_Enabled}"
                                           Description="{x:Static core:Resources.Settings_Control_EnabledDescription}">
                    <!--
                        总开关：bool 配置项，直接双向绑即可（配置 handler 自带落盘）。
                        重连由后台服务监听配置后自己做，页面不调 Restart。
                    -->
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.ControlCenter.Enabled, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!--
                    连接状态：在线时只显示一颗绿点 +「在线」，详情行整行收起；
                    其它状态（未接入 / 连接中 / 已失效）才显示那句补充说明。
                -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_Status}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="4" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                         IsVisible="{Binding IsOnline}" />
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding StatusText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock MaxWidth="320"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding DetailText}"
                                       IsVisible="{Binding HasDetail}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!--
                    作业自动备份：默认开，只往集控传一份只读快照（不是远程控制）。
                    状态行由服务推送，最近一次成功时间 / 上次失败 / 还没备份过。
                -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_HomeworkBackup_Title}"
                                           Description="{x:Static core:Resources.Settings_Control_HomeworkBackup_Description}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="4" HorizontalAlignment="Right">
                            <ToggleSwitch HorizontalAlignment="Right"
                                          IsChecked="{Binding Config.ControlCenter.HomeworkBackupEnabled, Mode=TwoWay}" />
                            <TextBlock MaxWidth="320"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding HomeworkBackupStatusText}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <!-- ============================== 设备 ============================== -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_DeviceSection}"
                                   IsExpanded="True">
                <!-- 网页控制台放在卡头：它作用于整张设备卡，不用再单独占一张设置卡。 -->
                <fa:FASettingsExpander.Footer>
                    <HyperlinkButton Command="{Binding OpenConsoleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Static icons:FluentIcons.OpenFilled}"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Static core:Resources.Settings_Control_OpenConsole}" />
                        </StackPanel>
                    </HyperlinkButton>
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_DisplayName}"
                                           Description="{x:Static core:Resources.Settings_Control_DisplayNameDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <!--
                            绑草稿而不是配置：每敲一个字符就写一遍 settings.json 太浪费。
                            失焦（或离开页面）时由 code-behind 调 CommitAll 落盘。
                        -->
                        <TextBox MinWidth="220"
                                 Text="{Binding DisplayNameDraft, Mode=TwoWay}"
                                 LostFocus="OnEditorLostFocus" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 只读的设备 ID：可选中，方便复制给管理员。 -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_DeviceId}">
                    <fa:FASettingsExpanderItem.Footer>
                        <SelectableTextBlock MaxWidth="320"
                                             TextAlignment="Right"
                                             TextWrapping="Wrap"
                                             Text="{Binding DeviceIdText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <!-- ============================ 接入（未接入） ============================ -->
            <!--
                地点 ID 支持把老师给的整句原样粘进来（Core 自己解析地点 ID 与配对码）。
                两个输入缺一不可，按钮只在两个都填了时可点。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_EnrollSection}"
                                   Description="{Binding EnrollDescription}"
                                   IsVisible="{Binding !IsConfigured}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.Footer>
                    <Button Command="{Binding EnrollCommand}"
                            Content="{Binding EnrollButtonText}"
                            IsEnabled="{Binding CanEnroll}" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_SiteId}"
                                           Description="{x:Static core:Resources.Settings_Control_SiteIdDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox MinWidth="260"
                                 Text="{Binding SiteIdDraft, Mode=TwoWay}"
                                 LostFocus="OnEditorLostFocus" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_PairCode}"
                                           Description="{x:Static core:Resources.Settings_Control_PairCodeDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <!-- 配对码是敏感输入，画成圆点。 -->
                        <TextBox MinWidth="220"
                                 PasswordChar="●"
                                 Text="{Binding PairCodeDraft, Mode=TwoWay}"
                                 LostFocus="OnEditorLostFocus" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <!-- ============================ 接入（已接入） ============================ -->
            <!--
                已接入：只留「清空」一个动作——它断开连接、删掉本机凭证（Core 的 ForgetEnrollmentAsync）。
                清空要先弹一句确认框（对话框是视图层的事，所以只有 Click，不绑 Command）；
                确认后 code-behind 再执行 ForgetCommand。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_ForgetTitle}"
                                   Description="{x:Static core:Resources.Settings_Control_ForgetConfirm}"
                                   IsVisible="{Binding IsConfigured}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.Footer>
                    <Button Click="OnForgetClick"
                            Content="{x:Static core:Resources.Settings_Control_Forget}"
                            IsEnabled="{Binding CanForget}" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Control_SiteName}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock MaxWidth="320"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Text="{Binding SiteNameText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>