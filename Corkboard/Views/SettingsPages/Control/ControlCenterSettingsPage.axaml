<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Control"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Corkboard.Views.SettingsPages.ControlCenter.ControlCenterSettingsPage"
             x:DataType="vm:ControlCenterSettingsPageViewModel">
    <ScrollViewer>
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Control_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!--
                扁平布局：每个设置项一张单层设置卡，控件全部放 Footer——打开页面就能看见，
                不需要点开任何一层。分区用小标题分组（样式同 Core 的 section-title，这里按页内尺寸手写）。
            -->

            <!-- ============================== 连接 ============================== -->
            <TextBlock Margin="0 12 0 4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static core:Resources.Settings_Control_SectionConnection}" />

            <!--
                总开关：bool 配置项，直接双向绑即可（配置 handler 自带落盘）。
                重连由后台服务监听配置后自己做，页面不调 Restart。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_Enabled}"
                                   Description="{x:Static core:Resources.Settings_Control_EnabledDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.ControlCenter.Enabled, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 连接状态：状态行加粗、详情行用次要色；内容由服务的快照推送，没有手动刷新按钮。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_Status}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding DetailText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                作业自动备份：默认开，只往集控传一份只读快照（不是远程控制）。
                状态行由服务推送，最近一次成功时间 / 上次失败 / 还没备份过。
                开关直接双向绑 bool 配置即可（与上面的总开关同一条规矩）。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_HomeworkBackup_Title}"
                                   Description="{x:Static core:Resources.Settings_Control_HomeworkBackup_Description}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Spacing="4">
                        <ToggleSwitch IsChecked="{Binding Config.ControlCenter.HomeworkBackupEnabled, Mode=TwoWay}" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding HomeworkBackupStatusText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- ============================ 设备与连接 ============================ -->
            <TextBlock Margin="0 12 0 4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static core:Resources.Settings_Control_DeviceSection}" />

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_DisplayName}"
                                   Description="{x:Static core:Resources.Settings_Control_DisplayNameDescription}">
                <fa:FASettingsExpander.Footer>
                    <!--
                        绑草稿而不是配置：每敲一个字符就写一遍 settings.json 太浪费。
                        失焦（或离开页面）时由 code-behind 调 CommitAll 落盘。
                    -->
                    <TextBox MinWidth="220"
                             Text="{Binding DisplayNameDraft, Mode=TwoWay}"
                             LostFocus="OnEditorLostFocus" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 只读的设备 ID：可选中，方便复制给管理员。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_DeviceId}">
                <fa:FASettingsExpander.Footer>
                    <SelectableTextBlock Text="{Binding DeviceIdText}"
                                         TextWrapping="Wrap" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 只读的地点名称：未接入时是占位符。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_SiteName}">
                <fa:FASettingsExpander.Footer>
                    <TextBlock Text="{Binding SiteNameText}"
                               TextWrapping="Wrap" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_OpenConsole}">
                <fa:FASettingsExpander.Footer>
                    <Button Command="{Binding OpenConsoleCommand}"
                            Content="{x:Static core:Resources.Settings_Control_OpenConsole}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- ============================= 接入集控 ============================= -->
            <TextBlock Margin="0 12 0 4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static core:Resources.Settings_Control_EnrollSection}" />

            <!--
                未接入：地点 ID 支持把老师给的整句原样粘进来（Core 自己解析地点 ID 与配对码）。
                两个输入缺一不可，按钮只在两个都填了时可点。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_Enroll}"
                                   Description="{x:Static core:Resources.Settings_Control_PasteHint}"
                                   IsVisible="{Binding !IsConfigured}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{x:Static core:Resources.Settings_Control_SiteId}" />
                        <TextBox MinWidth="200"
                                 Text="{Binding SiteIdDraft, Mode=TwoWay}"
                                 PlaceholderText="{x:Static core:Resources.Settings_Control_SiteIdDescription}"
                                 LostFocus="OnEditorLostFocus" />

                        <TextBlock VerticalAlignment="Center"
                                   Text="{x:Static core:Resources.Settings_Control_PairCode}" />
                        <!-- 配对码是敏感输入，画成圆点。 -->
                        <TextBox MinWidth="160"
                                 PasswordChar="●"
                                 Text="{Binding PairCodeDraft, Mode=TwoWay}"
                                 PlaceholderText="{x:Static core:Resources.Settings_Control_PairCodeDescription}"
                                 LostFocus="OnEditorLostFocus" />

                        <Button Command="{Binding EnrollCommand}"
                                Content="{Binding EnrollButtonText}"
                                IsEnabled="{Binding CanEnroll}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                已接入：只留「取消接入」一个动作。取消要先弹一句确认框（对话框是视图层的事，
                所以只有 Click，不绑 Command）；确认后 code-behind 再执行 ForgetCommand。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_EnrollSection}"
                                   IsVisible="{Binding IsConfigured}">
                <fa:FASettingsExpander.Footer>
                    <Button Click="OnForgetClick"
                            Content="{x:Static core:Resources.Settings_Control_Forget}"
                            IsEnabled="{Binding CanForget}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- ============================= 班级占用 ============================= -->
            <TextBlock Margin="0 12 0 4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static core:Resources.Settings_Control_ClassSection}" />

            <!-- 占着哪个班常显；选班 / 释放班 / 刷新清单在同一行。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_ClassSection}"
                                   Description="{x:Static core:Resources.Settings_Control_ClassDescription}"
                                   IsVisible="{Binding IsConfigured}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Static core:Resources.Settings_Control_ClassCurrent}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentClassText}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="240"
                                      ItemsSource="{Binding ClassOptions}"
                                      SelectedItem="{Binding SelectedClassOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ControlClassOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Command="{Binding SelectClassCommand}"
                                    Content="{x:Static core:Resources.Settings_Control_ClassSelect}"
                                    IsEnabled="{Binding CanSelectClass}" />
                            <Button Command="{Binding ReleaseClassCommand}"
                                    Content="{x:Static core:Resources.Settings_Control_ClassRelease}"
                                    IsEnabled="{Binding CanReleaseClass}" />
                            <Button Command="{Binding RefreshClassesCommand}"
                                    Content="{x:Static core:Resources.Settings_Control_ClassRefresh}" />
                        </StackPanel>
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- ============================== 高级 ============================== -->
            <TextBlock Margin="0 12 0 4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static core:Resources.Settings_Control_SectionAdvanced}" />

            <!-- 集控站点地址：留空则用默认地址（由配置的 Normalize 归一）。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Control_ServerUrl}"
                                   Description="{x:Static core:Resources.Settings_Control_ServerUrlDescription}">
                <fa:FASettingsExpander.Footer>
                    <TextBox MinWidth="260"
                             Text="{Binding ServerUrlDraft, Mode=TwoWay}"
                             LostFocus="OnEditorLostFocus" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>