<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Exam"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:icons="using:Corkboard.Core.Icons"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Corkboard.Views.SettingsPages.Exam.ExamScheduleSettingsPage"
             x:DataType="vm:ExamScheduleSettingsPageViewModel">
    <UserControl.Styles>
        <!-- 一行看板：内容为主、框线退到几乎没有，只在行与行之间留一条极浅的分隔。 -->
        <Style Selector="TextBlock.board-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.board-sub">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.board-meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.board-row">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
        <Style Selector="Border.active-badge">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.active-badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Exam_Schedule_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!-- 全屏看板入口：设置页里也能直接切到看板上确认效果。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Schedule_OpenBoard}"
                                   Description="{x:Static core:Resources.Settings_Exam_Schedule_OpenBoardDescription}">
                <fa:FASettingsExpander.Footer>
                    <Button VerticalAlignment="Center" Click="OnOpenBoardClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       Text="{x:Static icons:FluentIcons.FullScreenMaximizeFilled}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Static core:Resources.Settings_Exam_Schedule_OpenBoard}" />
                        </StackPanel>
                    </Button>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                看板文件列表：一份看板 = 一个文件，标题、副标题与考试安排都在里面。
                每一行右边是「编辑」（开编辑窗口）/「设为当前」（全屏看板显示哪一块）/「删除」。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Schedule_Board}"
                                   Description="{x:Static core:Resources.Settings_Exam_Schedule_BoardDescription}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.Footer>
                    <Button VerticalAlignment="Center" Click="OnCreateBoardClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                       Text="{x:Static icons:FluentIcons.AddFilled}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Static core:Resources.Settings_Exam_Schedule_BoardNew}" />
                        </StackPanel>
                    </Button>
                </fa:FASettingsExpander.Footer>

                <ItemsControl ItemsSource="{Binding Items}" Margin="0 2 0 0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExamBoardItem">
                            <Border Classes="board-row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="board-title" Text="{Binding Title}" />
                                            <!-- 「当前」只标在全屏看板正在显示的那一块上。 -->
                                            <Border Classes="active-badge" IsVisible="{Binding IsActive}">
                                                <TextBlock Text="{x:Static core:Resources.Settings_Exam_Schedule_BoardActive}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="board-sub"
                                                   IsVisible="{Binding HasSubtitle}"
                                                   Text="{Binding Subtitle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Classes="board-meta" Text="{Binding CountText}" />
                                            <TextBlock Classes="board-meta"
                                                       IsVisible="{Binding HasNext}"
                                                       Text="{Binding NextText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <!--
                                            三颗按钮一律图标、一律同尺寸：「编辑」原来带文字，跟另两颗图标按钮
                                            宽度高度都不一样，一行看过去歪歪扭扭（用户反馈「按钮的大小不一样」）。
                                        -->
                                        <Button Width="34" Height="34"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                Content="{x:Static icons:FluentIcons.EditFilled}"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardEditToolTip}"
                                                Click="OnEditBoardClick" />
                                        <Button Width="34" Height="34"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                Content="{x:Static icons:FluentIcons.PinFilled}"
                                                IsEnabled="{Binding !IsActive}"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardActivate}"
                                                Click="OnActivateBoardClick" />
                                        <Button Width="34" Height="34"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                Content="{x:Static icons:FluentIcons.DeleteFilled}"
                                                IsEnabled="{Binding $parent[ItemsControl].((vm:ExamScheduleSettingsPageViewModel)DataContext).CanDeleteBoard}"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardDelete}"
                                                Click="OnDeleteBoardClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
