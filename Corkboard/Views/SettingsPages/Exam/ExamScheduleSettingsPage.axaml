<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Exam"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:icons="using:Corkboard.Core.Icons"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Corkboard.Views.SettingsPages.Exam.ExamScheduleSettingsPage"
             x:DataType="vm:ExamScheduleSettingsPageViewModel">
    <UserControl.Styles>
        <!-- 一行看板：内容为主、框线退到几乎没有，只在行与行之间留一条极浅的分隔。 -->
        <Style Selector="TextBlock.board-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.board-sub">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.board-meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.board-row">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
        <!--
            最后一行底下没有下一行了，那条分界线就不该画（用户要求过：
            「后面没有别的文件了就别画线」）。行模板上用 Last 这个类挂上来。
        -->
        <Style Selector="Border.board-row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.active-badge">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.active-badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <!--
            看板管理面板：顶部一行工具栏 + 下面直接铺开的看板列表。
            刻意**不做**成可收纳的设置卡——按钮要一直看得见，列表也不用先点开才看到
            （用户反馈：「没必要做成可收纳的设置框，直接展开，上面放点工具栏」）。
        -->
        <Style Selector="Border.exam-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <!-- 工具栏按钮：图标 + 文字、不带底色，靠悬停高亮，跟旁边那颗开关一样低调。 -->
        <Style Selector="Button.exam-tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Exam_Schedule_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!--
                看板管理：工具栏在上、看板列表在下，一份看板就是列表里的一行。
                这块原来上面还有「看板」分区标题 + 一句「每个看板一个文件，标题与考试安排都在里面」，
                已按用户要求整块删掉（删一半只留标题更难看成「光秃秃一个词」），
                页标题「考试安排」下面直接就是面板，工具栏按钮自己说明它是干什么的。
            -->

            <Border Classes="exam-panel">
                <StackPanel Spacing="0">
                    <!--
                        工具栏：从左往右按「先看 → 再排 → 再建 → 再导」的顺序摆。
                        导入排在导出前面，跟别的软件里「导入名单 / 导出名单」一个习惯。
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="exam-tool"
                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_OpenBoardDescription}"
                                Click="OnOpenBoardClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.FullScreenMaximizeFilled}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Static core:Resources.Settings_Exam_Schedule_OpenBoard}" />
                            </StackPanel>
                        </Button>
                        <!--
                            「快速布置」放在「新建看板」左边：从零建一块看板最省事的路是排一场考试，
                            而不是先建一块空板再进去一条条录。
                        -->
                        <Button Classes="exam-tool"
                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Plan_QuickButtonToolTip}"
                                Click="OnQuickPlanClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.WandFilled}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Static core:Resources.Settings_Exam_Plan_QuickButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="exam-tool" Click="OnCreateBoardClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.AddFilled}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Static core:Resources.Settings_Exam_Schedule_BoardNew}" />
                            </StackPanel>
                        </Button>
                        <!--
                            导入：把别人发来的 .cbexam 考试文件追加到**当前这块**看板里。
                            放在这里是因为它和「快速布置」是同一类动作——都是往看板里批量加考试，
                            区别只是一个从对话框里排、一个从文件里读。
                        -->
                        <Button Classes="exam-tool"
                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_ImportToolTip}"
                                Click="OnImportExamsClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.OpenFilled}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Static core:Resources.Settings_Exam_Schedule_Import}" />
                            </StackPanel>
                        </Button>
                        <!--
                            导出：把**当前这块**看板里的考试整份存成一个 .cbexam。
                            和「导入考试」并排摆着：导入导出是一对动作，用户找其中一个时另一个就在手边。
                            单场导出在看板每一行的箭头按钮上（导的是那一场）。
                        -->
                        <Button Classes="exam-tool"
                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_ExportAllToolTip}"
                                Click="OnExportBoardClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.ArrowExportFilled}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Static core:Resources.Settings_Exam_Schedule_ExportAll}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Height="1"
                            Margin="0 8 0 0"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!--
                        看板列表：一份看板 = 一个文件，标题、副标题与考试安排都在里面。
                        每一行右边是「自动放映」（参不参加自动放映）/「编辑」（开编辑窗口）/
                        「设为当前」（全屏看板显示哪一块）/「导出」（把这一块存成文件）/「删除」。
                    -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExamBoardItem">
                                <Border Classes="board-row" Classes.last="{Binding IsLast}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="board-title" Text="{Binding Title}" />
                                                <!-- 「当前」只标在全屏看板正在显示的那一块上。 -->
                                                <Border Classes="active-badge" IsVisible="{Binding IsActive}">
                                                    <TextBlock Text="{x:Static core:Resources.Settings_Exam_Schedule_BoardActive}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="board-sub"
                                                       IsVisible="{Binding HasSubtitle}"
                                                       Text="{Binding Subtitle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Classes="board-meta" Text="{Binding CountText}" />
                                                <TextBlock Classes="board-meta"
                                                           IsVisible="{Binding HasNext}"
                                                           Text="{Binding NextText}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <!--
                                                每块看板自己决定参不参加自动放映（默认不参加）：开关改了直接写回
                                                这块看板的文件，跟「设为当前」是两件独立的事。
                                            -->
                                            <ToggleSwitch MinWidth="0"
                                                          Margin="0 0 6 0"
                                                          VerticalAlignment="Center"
                                                          OnContent=""
                                                          OffContent=""
                                                          IsChecked="{Binding AutoShowEnabled, Mode=TwoWay}"
                                                          ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardAutoShow}" />
                                            <!--
                                                四颗按钮一律图标、一律同尺寸：「编辑」原来带文字，跟另几颗图标按钮
                                                宽度高度都不一样，一行看过去歪歪扭扭（用户反馈「按钮的大小不一样」）。
                                            -->
                                            <Button Width="34" Height="34"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                    Content="{x:Static icons:FluentIcons.EditFilled}"
                                                    ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardEditToolTip}"
                                                    Click="OnEditBoardClick" />
                                            <Button Width="34" Height="34"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                    Content="{x:Static icons:FluentIcons.PinFilled}"
                                                    IsEnabled="{Binding !IsActive}"
                                                    ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardActivate}"
                                                    Click="OnActivateBoardClick" />
                                            <Button Width="34" Height="34"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                    Content="{x:Static icons:FluentIcons.ArrowExportFilled}"
                                                    ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_ExportBoardToolTip}"
                                                    Click="OnExportBoardClick" />
                                            <Button Width="34" Height="34"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                    Content="{x:Static icons:FluentIcons.DeleteFilled}"
                                                    IsEnabled="{Binding $parent[ItemsControl].((vm:ExamScheduleSettingsPageViewModel)DataContext).CanDeleteBoard}"
                                                    ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Schedule_BoardDelete}"
                                                    Click="OnDeleteBoardClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--
                考试模板：在编辑窗口里点「另存为模板」存下来的排法。
                模板里只有「第几天几点考什么」，所以这里一行都不显示日期——
                套用时在向导第 1 步选它、再挑这次的第一天就行。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Plan_TemplateList}"
                                   Description="{x:Static core:Resources.Settings_Exam_Plan_TemplateListDescription}"
                                   IsExpanded="True">
                <StackPanel Spacing="2">
                    <ItemsControl ItemsSource="{Binding Templates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExamTemplateItem">
                                <Border Classes="board-row" Classes.last="{Binding IsLast}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="board-title" Text="{Binding Name}" />
                                            <TextBlock Classes="board-meta" Text="{Binding Summary}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Width="34" Height="34"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                Content="{x:Static icons:FluentIcons.DeleteFilled}"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Exam_Plan_TemplateDelete}"
                                                Click="OnDeleteTemplateClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,10,0,0"
                               Classes="board-meta"
                               IsVisible="{Binding HasNoTemplate}"
                               Text="{x:Static core:Resources.Settings_Exam_Plan_TemplateListEmpty}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
