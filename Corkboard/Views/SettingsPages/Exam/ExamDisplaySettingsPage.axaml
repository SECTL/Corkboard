<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Exam"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Corkboard.Views.SettingsPages.Exam.ExamDisplaySettingsPage"
             x:DataType="vm:ExamDisplaySettingsPageViewModel">
    <ScrollViewer>
        <StackPanel Classes="page-container">
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Exam_Display_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!--
                三档状态的分界：开考前 N 分钟之内算「即将开始」，之前是「未开始」，
                开考之后到收卷是「进行中」。默认 30 分钟。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Display_Threshold}"
                                   Description="{x:Static core:Resources.Settings_Exam_Display_ThresholdDescription}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <NumericUpDown MinWidth="130"
                                       Minimum="1"
                                       Maximum="1440"
                                       Increment="5"
                                       FormatString="0"
                                       Value="{Binding ThresholdDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static core:Resources.Common_Minutes}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 时钟与考试列表谁在左边。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Display_ClockSide}"
                                   Description="{x:Static core:Resources.Settings_Exam_Display_ClockSideDescription}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="160"
                              ItemsSource="{Binding ClockSideOptions}"
                              SelectedItem="{Binding SelectedClockSideOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExamClockSideOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                两种形态的取舍：
                「即将开始」默认把整张表收起来，只留下一场（科目 + 时间 + 状态）；
                「进行中」默认只留一个大时钟，想看卷面信息再把开关打开。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Display_HideListUpcoming}"
                                   Description="{x:Static core:Resources.Settings_Exam_Display_HideListUpcomingDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.HideExamListWhenUpcoming, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Display_ShowListInProgress}"
                                   Description="{x:Static core:Resources.Settings_Exam_Display_ShowListInProgressDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowExamListInProgress, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                列表收起时时钟下面那句「还剩 40 分钟」，剩到这个分钟数就转红。
                0 表示不提醒。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Display_WarningMinutes}"
                                   Description="{x:Static core:Resources.Settings_Exam_Display_WarningMinutesDescription}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <NumericUpDown MinWidth="130"
                                       Minimum="0"
                                       Maximum="240"
                                       Increment="5"
                                       FormatString="0"
                                       Value="{Binding WarningDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static core:Resources.Common_Minutes}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                倒计时的精确度：开到最后 1 小时的倒计时带秒（「还剩 12 分 30 秒」），
                一小时以上仍然只说小时/分钟。开关是离散动作，直接双向绑配置。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Display_RemainingSeconds}"
                                   Description="{x:Static core:Resources.Settings_Exam_Display_RemainingSecondsDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RemainingSecondsEnabled, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
