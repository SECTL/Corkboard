<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Exam"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="900"
             x:Class="Corkboard.Views.SettingsPages.Exam.ExamLayoutSettingsPage"
             x:DataType="vm:ExamLayoutSettingsPageViewModel">
    <!--
        看板布局设置页：四档考试状态各存一套组件摆法，默认走原版式（零变化），
        点「编辑」在独立的全屏编辑窗里用示例考试调整，改完一次性写回配置。
    -->
    <ScrollViewer>
        <StackPanel Classes="page-container">
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Exam_Layout_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Layout_Intro_Title}"
                                   Description="{x:Static core:Resources.Settings_Exam_Layout_Intro_Description}" />

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Exam_Layout_States_Title}"
                                   Description="{x:Static core:Resources.Settings_Exam_Layout_States_Description}"
                                   ItemsSource="{Binding Rows}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExamLayoutStatusRow">
                        <fa:FASettingsExpanderItem Content="{Binding Name}"
                                                   Description="{Binding StateText}">
                            <fa:FASettingsExpanderItem.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static core:Resources.Settings_Exam_Layout_Edit}"
                                            Command="{Binding EditCommand}" />
                                    <Button Content="{x:Static core:Resources.Settings_Exam_Layout_ResetState}"
                                            Command="{Binding ResetCommand}"
                                            IsEnabled="{Binding IsCustomized}" />
                                </StackPanel>
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>
                    </DataTemplate>
                </fa:FASettingsExpander.ItemTemplate>
            </fa:FASettingsExpander>

            <Border Classes="card" Margin="0 8 0 0">
                <TextBlock TextWrapping="Wrap"
                           Text="{x:Static core:Resources.Settings_Exam_Layout_Hint}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>