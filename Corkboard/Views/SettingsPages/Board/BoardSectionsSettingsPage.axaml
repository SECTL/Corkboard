<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:icons="using:Corkboard.Core.Icons"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Board"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Corkboard.Views.SettingsPages.Board.BoardSectionsSettingsPage"
             x:DataType="vm:BoardSectionsSettingsPageViewModel">
    <ScrollViewer>
        <!--
            设置卡：Header 是设置项名称，Description 是简介，Footer 放控件；
            内容多的（科目清单、分类列表）放在卡片内容区，见 Core/Styles/StylesBase.axaml。
        -->
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Board_Sections_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!--
                科目清单：逗号分隔的草稿，失焦 / 回车时提交并落盘（科目是业务数据，不走配置管道）。
                不用按回车也能提交——离开页面时 Unloaded 会再提交一次。
            -->
            <!--
                科目清单：**一个一个加**（输入框 + 添加按钮，回车也行），不再用逗号分隔的长文本框
                （用户明确要求）。每行右侧的叉删掉这个科目，删之前确认一次。
                科目与分类都是业务数据（存在 board.json），这边显式落盘，不走配置管道。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Subjects}"
                                   Description="{x:Static core:Resources.Settings_Board_SubjectsDescription}"
                                   IsExpanded="True">
                <StackPanel Margin="0 4 0 0" Spacing="8">
                    <TextBlock Classes="caption"
                               IsVisible="{Binding HasSubjectHint}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding SubjectHint}" />

                    <TextBlock Classes="caption"
                               IsVisible="{Binding HasNoSubjects}"
                               Text="{x:Static core:Resources.Settings_Board_Subjects_Empty}" />

                    <!--
                        已有的科目：**胶囊横排、多了自动换行**（用户要求：语文、数学这种短名字
                        横着放就行，不必一行一个竖着排）。胶囊里是名字 + 一颗小叉删科目；
                        改名请删了重加（科目是数据里的定义，直接改名会牵扯作业归属）。
                    -->
                    <ItemsControl ItemsSource="{Binding SubjectItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BoardSectionsSubjectItem">
                                <Border Margin="0 0 8 8"
                                        Padding="12 4 4 4"
                                        CornerRadius="14"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}" />
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                FontSize="12"
                                                Content="{x:Static icons:FluentIcons.DeleteFilled}"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Board_Subjects_Delete}"
                                                Click="OnDeleteSubjectClick" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 新建科目：输入框里有字才能点「添加」；回车也能加。 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewSubjectDraft, Mode=TwoWay}"
                                 PlaceholderText="{x:Static core:Resources.Settings_Board_Subjects_NewPlaceholder}"
                                 KeyDown="OnNewSubjectKeyDown" />
                        <Button Grid.Column="1"
                                MinHeight="32"
                                Padding="12 0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding CanAddSubject}"
                                Content="{x:Static core:Resources.Settings_Board_Subjects_Add}"
                                Click="OnAddSubjectClick" />
                    </Grid>
                </StackPanel>
            </fa:FASettingsExpander>

            <!--
                二级分类：每个科目一块，列出它下面已定义的分类（就地改名 / 删除），最后一行新建。
                分类顺序就是显示顺序；删除只是把定义删掉，里面的作业会回到科目下面。
                失败（重名之类）时卡片顶部出现一句提示，不用弹窗。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Sections_Categories}"
                                   Description="{x:Static core:Resources.Settings_Board_Sections_CategoriesDescription}"
                                   IsExpanded="True">
                <StackPanel Margin="0 4 0 0" Spacing="12">
                    <TextBlock Classes="caption"
                               IsVisible="{Binding HasSectionHint}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding SectionHint}" />

                    <!--
                        左边选科目、右边编辑：科目多了以后一行一行往下排太长（用户要求改成这种布局）。
                        右边只放选中那个科目的分类行，**不再放科目下拉框**——左边既然能选，右边再来一颗就是重复。
                    -->
                    <Grid ColumnDefinitions="220,*"
                          ColumnSpacing="16"
                          MinHeight="280">
                        <Border Grid.Column="0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <ListBox ItemsSource="{Binding SubjectItems}"
                                     SelectedItem="{Binding SelectedSubjectItem, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BoardSectionsSubjectItem">
                                        <StackPanel Spacing="2" Margin="0 2">
                                            <TextBlock FontWeight="Bold"
                                                       Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Classes="caption" Text="{Binding CategoryCountText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!--
                            右列只放「当前科目的分类」。科目本身由左边列表选（用户要求：
                            左边既然能选，上面就不要再多一颗科目下拉框了）。
                            行距刻意放宽一点：输入框之间挨太近看着挤（用户反馈）。
                        -->
                        <ContentControl Grid.Column="1"
                                        Margin="0 2"
                                        Content="{Binding SelectedSubjectItem}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:BoardSectionsSubjectItem">
                                    <!--
                                        **统一**行距（用户反馈：不要忽大忽小，也不要太大）：
                                        列表行之间、列表行与新建行之间都是同一个 8 DIP；
                                        行内不再加 Margin，输入框高度固定 32、文字垂直居中，
                                        不靠 Padding 撑高——那样看着像「一行字上面又套了个空框」。
                                    -->
                                    <StackPanel Spacing="8">
                                        <!-- 已定义的分类：一行一个，输入框直接改名（失焦 / 回车提交）。 -->
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BoardSectionsCategoryItem">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBox Grid.Column="0"
                                                                 MinHeight="32"
                                                                 VerticalContentAlignment="Center"
                                                                 Text="{Binding NameDraft, Mode=TwoWay}"
                                                                 LostFocus="OnCategoryNameLostFocus"
                                                                 KeyDown="OnCategoryNameKeyDown"
                                                                 ToolTip.Tip="{x:Static core:Resources.Settings_Board_Sections_RenameCategory}" />
                                                        <Button Grid.Column="1"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="6"
                                                                VerticalAlignment="Center"
                                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                                Content="{x:Static icons:FluentIcons.DeleteFilled}"
                                                                ToolTip.Tip="{x:Static core:Resources.Settings_Board_Sections_DeleteCategory}"
                                                                Click="OnDeleteCategoryClick" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Classes="caption"
                                                   IsVisible="{Binding !HasCategories}"
                                                   Text="{x:Static core:Resources.Settings_Board_Sections_NoCategories}" />

                                        <!-- 新建分类：输入框里有字才能点按钮；回车也能建。 -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0"
                                                     MinHeight="32"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding NewCategoryDraft, Mode=TwoWay}"
                                                     PlaceholderText="{x:Static core:Resources.Settings_Board_Sections_NewCategoryPlaceholder}"
                                                     KeyDown="OnNewCategoryKeyDown" />
                                            <Button Grid.Column="1"
                                                    MinHeight="32"
                                                    Padding="12 0"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanAddCategory}"
                                                    Content="{x:Static core:Resources.Settings_Board_Sections_AddCategory}"
                                                    Click="OnAddCategoryClick" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </StackPanel>
            </fa:FASettingsExpander>

            <!--
                快捷标签：布置作业时点一下就能把标签插进内容里，省得每次手打。
                标签存在配置里（settings.json），增删之后由子 VM 显式落盘；
                输入框绑的是草稿属性，不是双向绑配置——配置每变一次就写一遍盘。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_QuickTags_List}"
                                   Description="{x:Static core:Resources.Settings_Board_QuickTags_ListDescription}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox MinWidth="200"
                                 VerticalAlignment="Center"
                                 PlaceholderText="{x:Static core:Resources.Settings_Board_QuickTags_Placeholder}"
                                 Text="{Binding Tags.TagDraft, Mode=TwoWay}"
                                 KeyDown="OnTagDraftKeyDown" />
                        <Button VerticalAlignment="Center"
                                Command="{Binding Tags.AddTagCommand}"
                                IsEnabled="{Binding Tags.CanAddDraft}"
                                Content="{x:Static core:Resources.Settings_Board_QuickTags_Add}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>

                <StackPanel Spacing="8" Margin="0 4 0 0">
                    <TextBlock Classes="caption"
                               Text="{x:Static core:Resources.Settings_Board_QuickTags_Empty}"
                               IsVisible="{Binding Tags.IsTagListEmpty}" />

                    <!--
                        已有的标签：**胶囊横排、多了自动换行**（和上面科目胶囊同一套做法，用户要求），
                        胶囊里是名字 + 一颗小叉删标签。
                    -->
                    <ItemsControl ItemsSource="{Binding Tags.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickTagItem">
                                <Border Margin="0 0 8 8"
                                        Padding="12 4 4 4"
                                        CornerRadius="14"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6"
                                                FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                                Content="&#xE61C;"
                                                ToolTip.Tip="{x:Static core:Resources.Settings_Board_QuickTags_Delete}"
                                                Click="OnDeleteTagClick" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 计数提示：「已加 N 个，最多 M 个」。到上限时新增按钮不可点，这行同时算提示。 -->
                    <TextBlock Classes="caption" Text="{Binding Tags.CountText}" />
                </StackPanel>
            </fa:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
