<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Board"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Corkboard.Views.SettingsPages.Board.BoardSettingsPage"
             x:DataType="vm:BoardSettingsPageViewModel">
    <ScrollViewer>
        <!--
            设置卡：Header 是设置项名称，Description 是简介，Footer 放控件。
            一张卡里塞了好几项时，用 fa:FASettingsExpanderItem 分行——左边是这一行的名称与简介，
            右边 Footer 放它自己的控件，别把名称、控件、说明全挤在左侧一列里。
            见 Core/Styles/StylesBase.axaml。
        -->
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Board_General_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <!--
                作业板名称：不用按回车——停手 400ms 会自动提交（见 ViewModel 的 OnBoardNameDraftChanged），
                回车与失焦则立刻提交。这个名字同时是主窗口标题。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Name}">
                <fa:FASettingsExpander.Footer>
                    <TextBox MinWidth="240"
                             Text="{Binding BoardNameDraft, Mode=TwoWay}"
                             PlaceholderText="{x:Static core:Resources.Settings_Board_NamePlaceholder}"
                             KeyDown="OnBoardNameKeyDown"
                             LostFocus="OnEditorLostFocus" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                排布（展示设置）：主页面顶部不放切换器，这里是唯一入口。
                排序方式不在这里：它已经搬到主界面标题栏的排序按钮上（见 MainView）。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Layout}"
                                   Description="{x:Static core:Resources.Settings_Board_LayoutDescription}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="240"
                              ItemsSource="{Binding LayoutOptions}"
                              SelectedItem="{Binding SelectedLayoutOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BoardLayoutOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                 拖拽排序：关掉之后作业板上不再画那颗拖动按钮，科目区块的标题行也不接管指针。
                 它是显示偏好，不影响任何数据；默认开着（用户要的是「能关」）。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_SubjectReorderEnabled}"
                                   Description="{x:Static core:Resources.Settings_Board_SubjectReorderEnabledDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Config.BoardSettings.SubjectReorderEnabled, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                区块宽度（展示设置）：只在「区块」排布下起作用，别的排布里整张卡隐藏（不留点不动的控件）。
                上面那一格是单块的基准宽度——它决定一行排几块；下面那个开关决定这宽度是死的还是活的：
                开着时单块在基准宽度与它的上限之间随窗口伸缩（宽到上限才换行），关掉就固定成基准宽度。
                上下限与 Core 的 BoardBlockStyle 一致，ViewModel 提交时还会再夹一次，
                手输越界值不会落到配置里。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_BlockMinWidth}"
                                   Description="{x:Static core:Resources.Settings_Board_BlockMinWidthDescription}"
                                   IsVisible="{Binding IsBlockLayout}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown MinWidth="130"
                                   Minimum="220"
                                   Maximum="600"
                                   Increment="10"
                                   FormatString="0"
                                   Value="{Binding BlockMinWidthDraft, Mode=TwoWay}"
                                   LostFocus="OnEditorLostFocus" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_BlockWidthAdaptive}"
                                           Description="{x:Static core:Resources.Settings_Board_BlockWidthAdaptiveDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Board.BlockWidthAdaptive, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <!--
                界面入口：标题栏右上角那排动作按钮 + 右下角的布置作业浮标。
                嫌哪颗多余就关掉哪颗（用户要求）；两张卡合成一张是因为它们都是「界面上有哪些入口」。
                直接双向绑配置：开关本身就是布尔、点了就落一次盘，不存在「一路动一路写」的问题。
                「锁定窗口」那颗不在这里——它是穿透状态下唯一的解锁入口，必须常驻。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Entries}"
                                   Description="{x:Static core:Resources.Settings_Board_EntriesDescription}">
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_TitleBarSettings}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.BoardSettings.ShowTitleBarSettings, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_TitleBarSort}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.BoardSettings.ShowTitleBarSort, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_TitleBarAssign}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.BoardSettings.ShowTitleBarAssign, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_TitleBarExport}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.BoardSettings.ShowTitleBarExport, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_TitleBarReplay}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.BoardSettings.ShowTitleBarReplay, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_TitleBarDock}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.BoardSettings.ShowTitleBarDock, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <!-- 右下角布置作业浮标：开着时主窗口右下角浮一颗加号，顺手就能布置作业。 -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Basic_CornerAssignButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Config.Basic.ShowCornerAssignButton, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_ConfirmBeforeDelete}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Board.ConfirmBeforeDelete}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
