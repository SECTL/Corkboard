<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Board"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:icons="using:Corkboard.Core.Icons"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Corkboard.Views.SettingsPages.Board.BoardWindowSettingsPage"
             x:DataType="vm:BoardWindowSettingsPageViewModel">
    <ScrollViewer>
        <!--
            设置卡：Header 是设置项名称，Description 是简介，Footer 放控件。
            两个分区：窗口（平台能力）、收纳（浮钮）。
        -->
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Board_Window_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Classes="section-title"
                       Text="{x:Static core:Resources.Settings_Section_Window}" />

            <!-- 平台不支持的能力整张卡隐藏，而不是留一个点不动的控件。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Basic_MainWindowOpacity}"
                                   Description="{x:Static core:Resources.Settings_Basic_MainWindowOpacityDescription}"
                                   IsVisible="{Binding IsWindowOpacitySupported}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!--
                            绑草稿而不是配置：拖滑杆时每帧都在变，直接写配置会连发落盘（见 ViewModel）。
                            拖完停手 400ms 落到配置上，主窗口立刻跟着变。
                        -->
                        <Slider MinWidth="180"
                                Minimum="{Binding OpacityPercentMinimum}"
                                Maximum="{Binding OpacityPercentMaximum}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Value="{Binding OpacityPercent, Mode=TwoWay}" />

                        <TextBlock MinWidth="44"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Text="{Binding OpacityDisplayText}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 平台不支持的能力整张卡隐藏，而不是留一个点不动的开关。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Basic_PinToDesktop}"
                                   Description="{x:Static core:Resources.Settings_Basic_PinToDesktopDescription}"
                                   IsVisible="{Binding IsPinToDesktopSupported}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Basic.PinToDesktop}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 平台不支持的能力整张卡隐藏，而不是留一个点不动的开关。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Basic_WindowCorners}"
                                   Description="{x:Static core:Resources.Settings_Basic_WindowCornersDescription}"
                                   IsVisible="{Binding IsWindowCornersSupported}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Basic.MainWindowRoundedCorners}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Basic_HoldToDragWindow}"
                                   Description="{x:Static core:Resources.Settings_Basic_HoldToDragWindowDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Basic.HoldToDragWindow}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 平台不支持的能力整张卡隐藏，而不是留一个点不动的开关。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Basic_ClickThrough}"
                                   Description="{x:Static core:Resources.Settings_Basic_ClickThroughDescription}"
                                   IsVisible="{Binding IsClickThroughSupported}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Basic.ClickThrough}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <TextBlock Classes="section-title"
                       Text="{x:Static core:Resources.Settings_Board_Dock_Title}" />

            <!-- 开关：决定标题栏上有没有「收纳」按钮。开关是离散动作，直接双向绑配置即可。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Dock_Enabled}"
                                   Description="{x:Static core:Resources.Settings_Board_Dock_EnabledDescription}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Dock.Settings.DockEnabled, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                位置：平时只显示一颗像下拉框的按钮（「右上」这种文案），点开才在浮层里展开九宫格
                圆点图——九宫格常驻太占面积（用户反馈）。选中那颗用 accent 样式亮起来；
                圆点本身是离散点击，点一下直接写配置，不需要提交草稿。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Dock_Anchor}"
                                   Description="{x:Static core:Resources.Settings_Board_Dock_AnchorDescription}">
                <fa:FASettingsExpander.Footer>
                    <Panel>
                        <Button x:Name="AnchorPickerButton"
                                MinWidth="180"
                                HorizontalContentAlignment="Stretch"
                                ToolTip.Tip="{x:Static core:Resources.Settings_Board_Dock_AnchorHint}"
                                Click="OnAnchorPickerClick">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Dock.AnchorText}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                           Text="{x:Static icons:FluentIcons.ChevronDownFilled}" />
                            </Grid>
                        </Button>

                        <!--
                            ⚠️ 这里用 Popup 而不是 Button.Flyout：Flyout 的内容在独立弹窗里，
                            DataContext 不会跟着按钮走，九宫格圆点的 Command 会静默失效
                            （用户反馈「点圆点没反应、下拉框一直显示右下」就是这么来的）。
                            Popup 声明在同一个可视树里，DataContext 正常继承，圆点才点得动。
                        -->
                        <Popup x:Name="AnchorPopup"
                               PlacementTarget="{Binding #AnchorPickerButton}"
                               Placement="BottomEdgeAlignedRight"
                               IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{x:Static core:Resources.Settings_Board_Dock_AnchorHint}" />
                                    <!-- 「屏幕」示意框：只是给九颗圆点一个参照，本身不参与任何交互。 -->
                                    <Border Width="264"
                                            Height="150"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8">
                                        <ItemsControl ItemsSource="{Binding Dock.AnchorOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="3" Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DockAnchorOption">
                                                    <Button Width="32"
                                                            Height="32"
                                                            MinWidth="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="16"
                                                            Classes.accent="{Binding IsSelected}"
                                                            Command="{Binding SelectCommand}"
                                                            Click="OnAnchorDotClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                位置微调：以刚才选中的位置为基准挪一点，一行左右、一行上下。
                连续输入走草稿，失焦或离开页面才提交（见 DockSettingsPageViewModel.CommitAll）。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Dock_Offset}"
                                   Description="{x:Static core:Resources.Settings_Board_Dock_OffsetDescription}">
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_Dock_OffsetX}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="130"
                                       Minimum="0"
                                       Maximum="2000"
                                       Increment="10"
                                       FormatString="0"
                                       Value="{Binding Dock.DockOffsetXDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_Dock_OffsetY}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="130"
                                       Minimum="0"
                                       Maximum="2000"
                                       Increment="10"
                                       FormatString="0"
                                       Value="{Binding Dock.DockOffsetYDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <!-- 按钮大小：按百分比缩放浮钮，落盘后已经收起来的那颗会立刻换大小。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Dock_Scale}"
                                   Description="{x:Static core:Resources.Settings_Board_Dock_ScaleDescription}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <NumericUpDown MinWidth="130"
                                       Minimum="60"
                                       Maximum="200"
                                       Increment="5"
                                       FormatString="0"
                                       Value="{Binding Dock.DockScaleDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                        <TextBlock VerticalAlignment="Center" Text="%" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Button HorizontalAlignment="Left"
                    Content="{x:Static core:Resources.Settings_Board_Dock_Reset}"
                    Click="ResetButton_OnClick" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
