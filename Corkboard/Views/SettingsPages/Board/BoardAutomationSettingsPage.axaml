<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages.Board"
             xmlns:hm="using:Corkboard.ViewModels.SettingsPages.Homework"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Corkboard.Views.SettingsPages.Board.BoardAutomationSettingsPage"
             x:DataType="vm:BoardAutomationSettingsPageViewModel">
    <ScrollViewer>
        <!--
            设置卡：Header 是设置项名称，Description 是简介，Footer 放控件。
            一个卡里有多项时用 fa:FASettingsExpanderItem 分行——名称与简介在左，控件在右。
            四个分区：自动清理、历史与回放、自动保存、数据维护。
        -->
        <StackPanel Classes="page-container">
            <!-- 页标题画在 page-container 里：它才和设置卡同宽、同左边缘，并随卡片一起滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Board_Automation_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Classes="section-title"
                       Text="{x:Static core:Resources.Settings_Board_Cleanup_Title}" />

            <!--
                自动清理：到点只给过了截止日期的作业打「已清理」标记，数据还在。
                时刻是草稿式的：选择器失焦 / 离开页面才提交（见 code-behind 的 OnEditorLostFocus）。
                「立即清理」不看开关也不看时刻，它和「清空作业板」一起放在下面的「数据维护」里。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_Cleanup}"
                                   Description="{x:Static core:Resources.Settings_Board_CleanupDescription}">
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_CleanupEnabled}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Cleanup.Settings.CleanupEnabled, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_CleanupFrequency}"
                                           Description="{x:Static core:Resources.Settings_Board_CleanupFrequencyDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox MinWidth="160"
                                  ItemsSource="{Binding Cleanup.CleanupFrequencyOptions}"
                                  SelectedItem="{Binding Cleanup.SelectedCleanupFrequencyOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="hm:HomeworkCleanupFrequencyOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 「星期几」只在按周清理时露出来，不留一个点不动的控件。 -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_CleanupWeekday}"
                                           IsVisible="{Binding Cleanup.IsWeeklyCleanup}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox MinWidth="160"
                                  ItemsSource="{Binding Cleanup.CleanupWeekdayOptions}"
                                  SelectedItem="{Binding Cleanup.SelectedCleanupWeekdayOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="hm:HomeworkCleanupWeekdayOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_CleanupTime}"
                                           Description="{x:Static core:Resources.Settings_Board_CleanupTimeDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TimePicker ClockIdentifier="24HourClock"
                                    UseSeconds="False"
                                    MinuteIncrement="1"
                                    SelectedTime="{Binding Cleanup.CleanupTimeDraft, Mode=TwoWay}"
                                    LostFocus="OnEditorLostFocus" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_CleanupLastResult}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center"
                                   MaxWidth="320"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Cleanup.CleanupLastResultText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <TextBlock Classes="section-title"
                       Text="{x:Static core:Resources.Settings_Board_History_Title}" />

            <!--
                保存粒度：同一条作业在窗口内连着改，只留最后一版。
                数值框全绑草稿，失焦 / 离开页面才提交（见 code-behind 的 OnEditorLostFocus）——
                直接双向绑配置会每动一格写一遍 settings.json。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_History_Coalesce}"
                                   Description="{x:Static core:Resources.Settings_Board_History_CoalesceDescription}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumericUpDown MinWidth="130"
                                       Minimum="{Binding History.MinCoalesceMinutes}"
                                       Maximum="{Binding History.MaxCoalesceMinutes}"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding History.CoalesceMinutesDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static core:Resources.Settings_Board_History_CoalesceUnit}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 保留天数：超过这么多天的历史文件在清理时删掉。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_History_Retention}"
                                   Description="{x:Static core:Resources.Settings_Board_History_RetentionDescription}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumericUpDown MinWidth="130"
                                       Minimum="{Binding History.MinRetentionDays}"
                                       Maximum="{Binding History.MaxRetentionDays}"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding History.RetentionDaysDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static core:Resources.Settings_Board_History_RetentionUnit}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 容量上限：历史占满这么多就从最老的那几天开始删，今天那份永远留着。 -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_History_MaxSize}"
                                   Description="{x:Static core:Resources.Settings_Board_History_MaxSizeDescription}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumericUpDown MinWidth="130"
                                       Minimum="{Binding History.MinMaxSizeMb}"
                                       Maximum="{Binding History.MaxMaxSizeMb}"
                                       Increment="10"
                                       FormatString="0"
                                       Value="{Binding History.MaxSizeMbDraft, Mode=TwoWay}"
                                       LostFocus="OnEditorLostFocus" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static core:Resources.Settings_Board_History_MaxSizeUnit}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                历史占用：只读统计 + 「立即清理历史」。
                按钮放在卡头 Footer 上，因为它作用于整张卡；统计行是「名称在左、数字在右」的 FASettingsExpanderItem。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_History_Usage}"
                                   Description="{x:Static core:Resources.Settings_Board_History_UsageDescription}">
                <fa:FASettingsExpander.Footer>
                    <Button Classes="accent"
                            VerticalAlignment="Center"
                            Content="{x:Static core:Resources.Settings_Board_History_PruneNow}"
                            Command="{Binding History.PruneHistoryCommand}" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_History_StatEntries}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center" Text="{Binding History.EntryCountText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_History_StatSnapshots}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center" Text="{Binding History.SnapshotCountText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_History_StatSize}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center" Text="{Binding History.SizeText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 点过清理之后才显示结果，没点过不留一行空文字。 -->
                <fa:FASettingsExpanderItem IsVisible="{Binding History.HasPruneResult}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center"
                                   MaxWidth="320"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding History.PruneResultText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <TextBlock Classes="section-title"
                       Text="{x:Static core:Resources.Settings_Board_AutoSave_Title}" />

            <!--
                自动保存：板子改完等几秒把整块板面存成一张 PNG（与手动「导出图片」是同一张长图）。
                「每天一张」当天覆盖，「每次修改都存」每笔改动一张；两种模式都按「保留天数」删旧的。
                默认关着、默认存在软件自己的数据目录里——不往用户文档目录里乱写东西。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_AutoSave}"
                                   Description="{x:Static core:Resources.Settings_Board_AutoSaveDescription}">
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSaveEnabled}"
                                           Description="{x:Static core:Resources.Settings_Board_AutoSaveEnabledDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding AutoSave.Settings.Enabled, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSave_Mode}"
                                           Description="{x:Static core:Resources.Settings_Board_AutoSave_ModeDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox MinWidth="160"
                                  ItemsSource="{Binding AutoSave.ModeOptions}"
                                  SelectedItem="{Binding AutoSave.SelectedModeOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoardAutoSaveModeOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSave_Retention}"
                                           Description="{x:Static core:Resources.Settings_Board_AutoSave_RetentionDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumericUpDown MinWidth="130"
                                           Minimum="{Binding AutoSave.MinRetentionDays}"
                                           Maximum="{Binding AutoSave.MaxRetentionDays}"
                                           Increment="1"
                                           FormatString="0"
                                           Value="{Binding AutoSave.RetentionDaysDraft, Mode=TwoWay}"
                                           LostFocus="OnEditorLostFocus" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{x:Static core:Resources.Settings_Board_AutoSave_RetentionUnit}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!--
                    保存位置：只能从文件夹选择器挑或恢复默认，不给手输。
                    手输一个打错的路径，结果是「开了自动保存却什么都没存」，而失败只记日志，用户发现不了。
                -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSave_Folder}"
                                           Description="{x:Static core:Resources.Settings_Board_AutoSave_FolderDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock MaxWidth="260"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding AutoSave.Folder}"
                                       Text="{Binding AutoSave.Folder}" />
                            <!-- 没自己挑过目录时标一句「默认位置」，省得用户以为这是自己设过的。 -->
                            <Border Padding="6 1"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    IsVisible="{Binding !AutoSave.HasCustomFolder}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{x:Static core:Resources.Settings_Board_AutoSave_FolderDefault}" />
                            </Border>
                            <Button Content="{x:Static core:Resources.Settings_Board_AutoSave_ChooseFolder}"
                                    Click="OnChooseFolderClick" />
                            <Button Content="{x:Static core:Resources.Settings_Board_AutoSave_OpenFolder}"
                                    Command="{Binding AutoSave.OpenFolderCommand}" />
                            <Button Content="{x:Static core:Resources.Settings_Board_AutoSave_ResetFolder}"
                                    Command="{Binding AutoSave.ResetFolderCommand}"
                                    IsVisible="{Binding AutoSave.HasCustomFolder}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 保存状态：上一次存到哪 / 为什么失败，右边一颗「立即保存一张」（关着开关也能手动存）。 -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSave_Status}"
                                           Description="{x:Static core:Resources.Settings_Board_AutoSave_StatusDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- 正常与失败各一条：失败时换成红色那条，别让「没存成功」看起来像普通状态。 -->
                            <TextBlock MaxWidth="260"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !AutoSave.HasError}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding AutoSave.StatusText}" />
                            <TextBlock MaxWidth="260"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding AutoSave.HasError}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding AutoSave.StatusText}" />
                            <Button Classes="accent"
                                    VerticalAlignment="Center"
                                    Content="{x:Static core:Resources.Settings_Board_AutoSave_SaveNow}"
                                    Command="{Binding AutoSave.SaveNowCommand}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSave_StatCount}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="{Binding AutoSave.CountText}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{x:Static core:Resources.Settings_Board_AutoSave_CountUnit}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Board_AutoSave_StatSize}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center" Text="{Binding AutoSave.SizeText}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <TextBlock Classes="section-title"
                       Text="{x:Static core:Resources.Settings_Section_Maintenance}" />

            <!--
                清空作业板：只是把作业从当前板子上收起来，数据与文件都还在（回放里能还原），
                所以不会失败、也没有备份要管。确认框在 code-behind 里弹（见 OnClearAllClick）。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_ClearAll}"
                                   Description="{x:Static core:Resources.Settings_Board_ClearAllDescription}">
                <fa:FASettingsExpander.Footer>
                    <Button VerticalAlignment="Center"
                            Content="{x:Static core:Resources.Settings_Board_ClearAll}"
                            Click="OnClearAllClick" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!--
                立即清理：不看开关也不看时刻，点一下把到了截止日期的作业当场清掉。
                跟上面那张一样是设置卡——裸一颗按钮没人知道它是干什么的（用户反馈过）；
                结果照旧看上面「自动清理」卡里的「上次清理」那一行（两者共用同一份状态）。
            -->
            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Board_CleanupRunNow}"
                                   Description="{x:Static core:Resources.Settings_Board_CleanupRunNowDescription}">
                <fa:FASettingsExpander.Footer>
                    <Button Classes="accent"
                            VerticalAlignment="Center"
                            Content="{x:Static core:Resources.Settings_Board_CleanupRunNow}"
                            Command="{Binding Cleanup.RunCleanupNowCommand}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
