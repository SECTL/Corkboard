<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="using:Corkboard.Core.Langs.Common"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="320"
        x:Class="Corkboard.Views.ControlCenter.ControlNoticeWindow"
        Title="{x:Static core:Resources.Control_Notice_FromControl}"
        WindowDecorations="None"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <!--
        集控公告浮窗。

        - 无边框、透明底 + 圆角实体卡片：无边框窗口如果自己有底色，圆角四角会露出方块黑角
          （与 PageOverlayWindow 同一个原因），所以窗口透明、卡片自己画。
        - ShowActivated=False：学生正在打字时不能抢焦点。窗口出现后用户不点它就不会夺走键盘。
        - 卡片限宽 520、正文区最高 420：公告太长时正文自己滚，窗口不会长成一条竖长板子。
        - 颜色全部走 Fluent 主题资源，亮暗主题与主题色都跟着应用走，不写死。
    -->
    <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            MinWidth="360"
            MaxWidth="520"
            Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Static core:Resources.Control_Notice_FromControl}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ScrollViewer x:Name="BodyScroll"
                          MaxHeight="420"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>

            <Button x:Name="CloseButton"
                    Classes="accent"
                    Content="{x:Static core:Resources.Control_Notice_Close}"
                    MinWidth="96"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>