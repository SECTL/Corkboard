<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>Corkboard.Core</PackageId>
        <Description>Corkboard 核心层：领域服务、配置与日志运行时、可复用 Avalonia 控件与样式，以及暴露给插件/应用层的服务契约。</Description>
        <Authors>SECTL</Authors>
        <Company>SECTL</Company>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageTags>corkboard;core</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="DynamicData" Version="9.4.33" />
        <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
        <!-- 富文本：作业内容的文档模型、显示控件与本地 HTML/JSON 序列化（见 Controls/RichTextBlock.cs）。 -->
        <PackageReference Include="AvaloniaRichEditor" Version="1.2.1" />
        <!-- 旧数据迁移与默认样式注入时按文本节点改 HTML（见 BoardHtmlStyling、LegacyBoardContentConverter）。 -->
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <!-- 旧数据的 Markdown 原文只在迁移时解析一次；迁移路径删掉后这个包也可以删。 -->
        <PackageReference Include="Markdig" Version="1.1.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Corkboard.Shared\Corkboard.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- 可复用样式随程序集打包，应用层用 avares:// 引用。 -->
        <AvaloniaResource Include="Styles\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Langs\Common\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Langs\Common\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <Import Project="..\Global.props" />

</Project>
